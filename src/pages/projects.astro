---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects.js';

const allProjects = projects;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": allProjects.map((project, index) => ({
    "@type": "CreativeWork",
    "position": index + 1,
    "name": project.title,
    "description": project.description,
    "url": project.liveUrl,
    "keywords": project.techStack.join(", "),
    "author": { "@type": "Person", "name": "Alkam Fariz" }
  }))
};
---

<Layout title="Projects">
  <script type="application/ld+json">{JSON.stringify(jsonLd)}</script>
  <section class="section">
    <div class="section-container">
      <h1 class="section-title text-gradient">My Projects</h1>
      <p class="section-subtitle">A showcase of things I've built and maintained.</p>

      {allProjects.length === 0 ? (
        <p id="no-projects" class="empty-state">No projects found</p>
      ) : (
        <div id="projects-grid" class="projects-grid">
          {allProjects.map((project) => (
            <div class="glass-card project-card" id={`project-${project.id}`}>
              <h3 class="project-title">{project.title}</h3>
              <p class="project-desc">{project.description}</p>
              <div class="tech-badges">
                {project.techStack.map(tech => (
                  <span class="tech-badge">{tech}</span>
                ))}
              </div>
              <div class="project-links">
                <a href={project.githubUrl} class="github-link" target="_blank" rel="noopener noreferrer">GitHub</a>
                {project.liveUrl && (
                  <a href={project.liveUrl} class="live-link" target="_blank" rel="noopener noreferrer">Live Demo</a>
                )}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .section {
    padding: 5rem 1.5rem;
  }
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: 0.75rem;
    text-align: center;
  }
  .section-subtitle {
    text-align: center;
    color: var(--text-muted);
    margin-bottom: 3rem;
    font-size: 1.1rem;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .project-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .project-title {
    font-size: 1.25rem;
    color: var(--text-light);
  }
  .project-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    flex-grow: 1;
  }
  .tech-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tech-badge {
    display: inline-block;
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.8rem;
  }
  .project-links {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }
  .github-link {
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 600;
    transition: color 0.2s;
  }
  .github-link:hover { color: var(--text-light); }
  .live-link {
    color: var(--accent-cyan);
    font-size: 0.9rem;
    font-weight: 600;
    transition: color 0.2s;
  }
  .live-link:hover { color: #a855f7; }
  .empty-state {
    text-align: center;
    color: var(--text-muted);
    font-size: 1.2rem;
    padding: 4rem;
  }
</style>
