---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects.js';

const allProjects = projects;

const uniqueTags = ['All', ...new Set(allProjects.flatMap(project => project.techStack))];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": allProjects.map((project, index) => ({
    "@type": "CreativeWork",
    "position": index + 1,
    "name": project.title,
    "description": project.description,
    "url": project.liveUrl,
    "keywords": project.techStack.join(", "),
    "author": { "@type": "Person", "name": "Alkam Fariz" }
  }))
};
---

<Layout title="Projects">
  <script type="application/ld+json">{JSON.stringify(jsonLd)}</script>
  <section class="section">
    <div class="section-container">
      <h1 class="section-title text-gradient">My Projects</h1>
      <p class="section-subtitle">A showcase of things I've built and maintained.</p>

      <!-- Filter Bar -->
      <div class="filter-container">
        {uniqueTags.map(tag => (
          <button class={`filter-btn ${tag === 'All' ? 'active' : ''}`} data-filter={tag}>
            {tag}
          </button>
        ))}
      </div>

      {allProjects.length === 0 ? (
        <p id="no-projects" class="empty-state">No projects found</p>
      ) : (
        <div id="projects-grid" class="projects-grid">
          {allProjects.map((project) => (
            <article class="glass-card project-card" id={`project-${project.id}`} data-tags={project.techStack.join(',')}>
              <div class="project-image-wrapper">
                {project.image ? (
                  <img src={project.image} alt={project.title} class="project-image" loading="lazy" />
                ) : (
                  <div class="project-image-placeholder" aria-hidden="true">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                  </div>
                )}
              </div>
              <div class="project-card-header">
                <h3 class="project-title">{project.title}</h3>
                {project.status && (
                  <span class={`status-badge ${project.status}`}>{project.status}</span>
                )}
              </div>
              {project.date && <small style="color: var(--text-muted); font-size: 0.8rem;">{project.date}</small>}
              <p class="project-desc">{project.description}</p>
              <div class="tech-badges">
                {project.techStack.map(tech => (
                  <span class="tech-badge">{tech}</span>
                ))}
              </div>
              <div class="project-links">
                <a href={project.githubUrl} class="github-link" target="_blank" rel="noopener noreferrer">GitHub</a>
                {project.liveUrl && (
                  <a href={project.liveUrl} class="live-link" target="_blank" rel="noopener noreferrer">Live Demo</a>
                )}
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Client-side filter script with URL params -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.project-card');

      function applyFilter(filter) {
        buttons.forEach(b => {
          b.classList.toggle('active', b.getAttribute('data-filter') === filter);
        });
        cards.forEach(card => {
          const tags = card.getAttribute('data-tags')?.split(',') || [];
          const isMatch = filter === 'All' || tags.includes(filter);
          if (isMatch) {
            card.style.display = 'flex';
            card.animate([
              { opacity: 0, transform: 'scale(0.96)' },
              { opacity: 1, transform: 'scale(1)' }
            ], { duration: 250, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' });
          } else {
            card.style.display = 'none';
          }
        });
        // Update URL without reload
        const url = new URL(window.location.href);
        if (filter === 'All') {
          url.searchParams.delete('tag');
        } else {
          url.searchParams.set('tag', filter);
        }
        window.history.replaceState({}, '', url.toString());
      }

      // Restore filter from URL on load
      const urlParams = new URLSearchParams(window.location.search);
      const tagParam = urlParams.get('tag');
      if (tagParam) {
        const matchBtn = Array.from(buttons).find(b => b.getAttribute('data-filter') === tagParam);
        if (matchBtn) {
          applyFilter(tagParam);
        }
      }

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          applyFilter(btn.getAttribute('data-filter'));
        });
      });

      // Handle browser back/forward
      window.addEventListener('popstate', () => {
        const params = new URLSearchParams(window.location.search);
        const tag = params.get('tag') || 'All';
        applyFilter(tag);
      });
    });
  </script>
</Layout>

<style>
  .section {
    padding: 5rem 1.5rem;
  }
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: 0.75rem;
    text-align: center;
  }
  .section-subtitle {
    text-align: center;
    color: var(--text-muted);
    margin-bottom: 2rem;
    font-size: 1.1rem;
  }
  .filter-container {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }
  .filter-btn {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    color: var(--text-muted);
    padding: 0.45rem 1.15rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition-smooth);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .filter-btn:hover {
    background: var(--glass-hover-bg);
    border-color: var(--accent-cyan);
    color: var(--text-light);
    transform: translateY(-2px);
  }
  .filter-btn.active {
    background: var(--gradient-primary);
    color: #0f172a;
    border-color: transparent;
    font-weight: 700;
    box-shadow: 0 4px 15px rgba(34, 211, 238, 0.3);
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .project-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .project-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .project-title {
    font-size: 1.25rem;
    color: var(--text-light);
  }
  .project-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    flex-grow: 1;
  }
  .tech-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tech-badge {
    display: inline-block;
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.8rem;
  }
  .project-links {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }
  .github-link {
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 600;
    transition: color 0.2s;
  }
  .github-link:hover { color: var(--text-light); }
  .live-link {
    color: var(--accent-cyan);
    font-size: 0.9rem;
    font-weight: 600;
    transition: color 0.2s;
  }
  .live-link:hover { color: #a855f7; }
  .empty-state {
    text-align: center;
    color: var(--text-muted);
    font-size: 1.2rem;
    padding: 4rem;
  }
</style>
