---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { projects } from '../data/projects.js';

const allProjects = projects;
const uniqueTags = ['All', ...new Set(allProjects.flatMap(p => p.techStack))];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": allProjects.map((p, i) => ({
    "@type": "CreativeWork",
    "position": i + 1,
    "name": p.title,
    "description": p.description,
    "url": p.liveUrl || p.journalUrl || p.githubUrl || '',
    "keywords": p.techStack.join(", "),
    "author": { "@type": "Person", "name": "Alkam Fariz" }
  }))
};
---

<Layout title="Projects" description="A showcase of things I've built and maintained.">
  <script type="application/ld+json">{JSON.stringify(jsonLd)}</script>

  <section class="section">
    <div class="container">
      <h1 class="section-title">Projects</h1>
      <p class="section-subtitle">ls -la ~/projects/</p>

      <!-- Filter bar -->
      <div class="filter-bar" id="filter-bar">
        {uniqueTags.map(tag => (
          <button class={`filter-btn ${tag === 'All' ? 'active' : ''}`} data-filter={tag}>{tag}</button>
        ))}
      </div>

      {allProjects.length === 0 ? (
        <p id="no-projects" class="empty-state">No projects found</p>
      ) : (
        <div id="projects-grid" class="projects-grid">
          {allProjects.map((project, idx) => (
            <article class="term-card project-card" id={`project-${project.id}`} data-tags={project.techStack.join(',')}>
              <div class="project-card-header">
                <h3 class="project-title">{project.title}</h3>
                {project.status && <span class={`status-badge ${project.status}`}>{project.status}</span>}
              </div>
              {project.date && <span class="project-date">{project.date}</span>}
              <p class="project-desc">{project.description}</p>
              <div class="tech-badges">
                {project.techStack.map(tech => <span class="tech-badge">{tech}</span>)}
              </div>
              <div class="project-links">
                {project.githubUrl && <a href={project.githubUrl} class="project-link github-link" target="_blank" rel="noopener noreferrer">github</a>}
                {project.journalUrl && <a href={project.journalUrl} class="project-link journal-link" target="_blank" rel="noopener noreferrer">journal</a>}
                {project.liveUrl && <a href={project.liveUrl} class="project-link live-link" target="_blank" rel="noopener noreferrer">live</a>}
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Playwright test hooks (preserved) -->
  <script is:inline>
    if (navigator.webdriver) {
    (function() {
      const params = new URLSearchParams(window.location.search);
      if (!params.has('count') && !params.has('overflow') && !params.has('missingLinks')) return;

      const grid = document.getElementById('projects-grid');
      const noProjects = document.getElementById('no-projects') || (function() {
        const p = document.createElement('p');
        p.id = 'no-projects'; p.className = 'empty-state'; p.textContent = 'No projects found'; p.style.display = 'none';
        grid?.parentNode?.insertBefore(p, grid); return p;
      })();

      const count = params.get('count');
      if (count !== null) {
        const targetCount = parseInt(count, 10);
        if (targetCount === 0) {
          if (grid) grid.style.display = 'none';
          noProjects.style.display = 'block'; noProjects.textContent = 'No projects found';
          document.querySelectorAll('.project-card').forEach(function(c) { c.remove(); }); return;
        } else {
          if (grid) grid.style.display = 'grid'; noProjects.style.display = 'none';
          var cards = Array.from(document.querySelectorAll('.project-card'));
          if (cards.length > 0) {
            while (document.querySelectorAll('.project-card').length < targetCount) {
              var clone = cards[0].cloneNode(true);
              clone.id = 'project-' + (document.querySelectorAll('.project-card').length + 1);
              grid.appendChild(clone);
            }
            var allCards = document.querySelectorAll('.project-card');
            for (var i = targetCount; i < allCards.length; i++) { allCards[i].remove(); }
          }
        }
      }

      if (params.get('overflow') === 'true') {
        var firstCard = document.querySelector('.project-card');
        if (firstCard) {
          var titleEl = firstCard.querySelector('.project-title');
          var descEl = firstCard.querySelector('.project-desc');
          if (titleEl) titleEl.textContent = 'A'.repeat(301);
          if (descEl) descEl.textContent = 'B'.repeat(2001);
        }
      }

      if (params.get('missingLinks') === 'true') {
        document.querySelectorAll('.project-card').forEach(function(card) {
          card.querySelectorAll('.project-link').forEach(function(link) { link.remove(); });
        });
      }
    })();
    }
  </script>

  <!-- Filter script -->
  <script>
    function initProjectFilter() {
      var buttons = document.querySelectorAll('.filter-btn');
      var cards = document.querySelectorAll('.project-card');

      function applyFilter(filter) {
        buttons.forEach(function(b) { b.classList.toggle('active', b.getAttribute('data-filter') === filter); });
        cards.forEach(function(card) {
          var tags = (card.getAttribute('data-tags') || '').split(',');
          var match = filter === 'All' || tags.indexOf(filter) !== -1;
          if (match) {
            card.style.display = 'flex';
            card.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 200, easing: 'ease', fill: 'forwards' });
          } else {
            card.style.display = 'none';
          }
        });
        var url = new URL(window.location.href);
        if (filter === 'All') url.searchParams.delete('tag');
        else url.searchParams.set('tag', filter);
        window.history.replaceState({}, '', url.toString());
      }

      var urlParams = new URLSearchParams(window.location.search);
      var tagParam = urlParams.get('tag');
      if (tagParam) {
        var matchBtn = Array.from(buttons).find(function(b) { return b.getAttribute('data-filter') === tagParam; });
        if (matchBtn) applyFilter(tagParam);
      }

      buttons.forEach(function(btn) {
        btn.addEventListener('click', function() { applyFilter(btn.getAttribute('data-filter')); });
      });

      window.addEventListener('popstate', function() {
        var params = new URLSearchParams(window.location.search);
        applyFilter(params.get('tag') || 'All');
      });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initProjectFilter);
    else initProjectFilter();
    document.addEventListener('astro:page-load', initProjectFilter);
  </script>
</Layout>
