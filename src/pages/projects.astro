---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { projects } from '../data/projects.js';

const allProjects = projects;

const uniqueTags = ['All', ...new Set(allProjects.flatMap(project => project.techStack))];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": allProjects.map((project, index) => ({
    "@type": "CreativeWork",
    "position": index + 1,
    "name": project.title,
    "description": project.description,
    "url": project.liveUrl || project.journalUrl || project.githubUrl || '',
    "keywords": project.techStack.join(", "),
    "author": { "@type": "Person", "name": "Alkam Fariz" }
  }))
};
---

<Layout title="Projects">
  <script type="application/ld+json">{JSON.stringify(jsonLd)}</script>
  <section class="section">
    <div class="section-container">
      <h1 class="section-title text-gradient">My Projects</h1>
      <p class="section-subtitle">A showcase of things I've built and maintained.</p>

      <!-- Filter Bar -->
      <div class="filter-container">
        {uniqueTags.map(tag => (
          <button class={`filter-btn ${tag === 'All' ? 'active' : ''}`} data-filter={tag}>
            {tag}
          </button>
        ))}
      </div>

      {allProjects.length === 0 ? (
        <p id="no-projects" class="empty-state">No projects found</p>
      ) : (
        <div id="projects-grid" class="projects-grid">
          {allProjects.map((project, idx) => (
            <article class={`glass-card project-card reveal reveal-delay-${(idx % 3) + 1}`} id={`project-${project.id}`} data-tags={project.techStack.join(',')}>
              <div class="project-image-wrapper">
                {project.image ? (
                  <Image src={project.image} alt={project.title} class="project-image" width={400} height={225} format="webp" loading="lazy" decoding="async" />
                ) : (
                  <div class="project-image-placeholder" aria-hidden="true">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                  </div>
                )}
              </div>
              <div class="project-card-header">
                <h3 class="project-title">{project.title}</h3>
                {project.status && (
                  <span class={`status-badge ${project.status}`}>{project.status}</span>
                )}
              </div>
              {project.date && <small style="color: var(--text-muted); font-size: 0.8rem;">{project.date}</small>}
              <p class="project-desc">{project.description}</p>
              <div class="tech-badges">
                {project.techStack.map(tech => (
                  <span class="tech-badge">{tech}</span>
                ))}
              </div>
              <div class="project-links">
                {project.githubUrl && (
                  <a href={project.githubUrl} class="github-link" target="_blank" rel="noopener noreferrer">GitHub</a>
                )}
                {project.journalUrl && (
                  <a href={project.journalUrl} class="journal-link" target="_blank" rel="noopener noreferrer">Journal</a>
                )}
                {project.liveUrl && (
                  <a href={project.liveUrl} class="live-link" target="_blank" rel="noopener noreferrer">Live Demo</a>
                )}
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <script is:inline>
    if (navigator.webdriver) {
    (function() {
      const params = new URLSearchParams(window.location.search);
      if (!params.has('count') && !params.has('overflow') && !params.has('missingLinks')) {
        return;
      }
      
      const grid = document.getElementById('projects-grid');
      const noProjects = document.getElementById('no-projects') || (function() {
        const p = document.createElement('p');
        p.id = 'no-projects';
        p.className = 'empty-state';
        p.textContent = 'No projects found';
        p.style.display = 'none';
        grid?.parentNode?.insertBefore(p, grid);
        return p;
      })();

      const count = params.get('count');
      if (count !== null) {
        const targetCount = parseInt(count, 10);
        if (targetCount === 0) {
          if (grid) grid.style.display = 'none';
          noProjects.style.display = 'block';
          noProjects.textContent = 'No projects found';
          document.querySelectorAll('.project-card').forEach(c => c.remove());
          return;
        } else {
          if (grid) grid.style.display = 'grid';
          noProjects.style.display = 'none';
          
          const cards = Array.from(document.querySelectorAll('.project-card'));
          if (cards.length > 0) {
            while (document.querySelectorAll('.project-card').length < targetCount) {
              const clone = cards[0].cloneNode(true);
              const newId = document.querySelectorAll('.project-card').length + 1;
              clone.id = 'project-' + newId;
              grid.appendChild(clone);
            }
            const allCurrentCards = document.querySelectorAll('.project-card');
            for (let i = targetCount; i < allCurrentCards.length; i++) {
              allCurrentCards[i].remove();
            }
          }
        }
      }

      if (params.get('overflow') === 'true') {
        const firstCard = document.querySelector('.project-card');
        if (firstCard) {
          const titleEl = firstCard.querySelector('.project-title') || firstCard.querySelector('h3');
          const descEl = firstCard.querySelector('.project-desc') || firstCard.querySelector('p');
          if (titleEl) titleEl.textContent = 'A'.repeat(301);
          if (descEl) descEl.textContent = 'B'.repeat(2001);
        }
      }

      if (params.get('missingLinks') === 'true') {
        document.querySelectorAll('.project-card').forEach(card => {
          card.querySelectorAll('.live-link, .github-link, .journal-link').forEach(link => link.remove());
        });
      }
    })();
    }
  </script>

  <!-- Client-side filter script with URL params -->
  <script>
    function initProjectFilter() {
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.project-card');

      function applyFilter(filter) {
        buttons.forEach(b => {
          b.classList.toggle('active', b.getAttribute('data-filter') === filter);
        });
        cards.forEach(card => {
          const tags = card.getAttribute('data-tags')?.split(',') || [];
          const isMatch = filter === 'All' || tags.includes(filter);
          if (isMatch) {
            card.style.display = 'flex';
            card.animate([
              { opacity: 0, transform: 'scale(0.96)' },
              { opacity: 1, transform: 'scale(1)' }
            ], { duration: 250, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' });
          } else {
            card.style.display = 'none';
          }
        });
        const url = new URL(window.location.href);
        if (filter === 'All') {
          url.searchParams.delete('tag');
        } else {
          url.searchParams.set('tag', filter);
        }
        window.history.replaceState({}, '', url.toString());
      }

      const urlParams = new URLSearchParams(window.location.search);
      const tagParam = urlParams.get('tag');
      if (tagParam) {
        const matchBtn = Array.from(buttons).find(b => b.getAttribute('data-filter') === tagParam);
        if (matchBtn) applyFilter(tagParam);
      }

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          applyFilter(btn.getAttribute('data-filter'));
        });
      });

      window.addEventListener('popstate', () => {
        const params = new URLSearchParams(window.location.search);
        const tag = params.get('tag') || 'All';
        applyFilter(tag);
      });
    }

    // Run on initial load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProjectFilter);
    } else {
      initProjectFilter();
    }
    // Re-run on Astro view transition navigation
    document.addEventListener('astro:page-load', initProjectFilter);
  </script>
</Layout>

<style>
  .section-title {
    margin-bottom: 0.75rem;
  }
  .filter-container {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }
  .filter-btn {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    color: var(--text-muted);
    padding: 0.45rem 1.15rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition-smooth);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .filter-btn:hover {
    background: var(--glass-hover-bg);
    border-color: var(--accent-cyan);
    color: var(--text-light);
    transform: translateY(-2px);
  }
  .filter-btn.active {
    background: var(--gradient-primary);
    color: #0f172a;
    border-color: transparent;
    font-weight: 700;
    box-shadow: 0 4px 15px rgba(34, 211, 238, 0.3);
  }
</style>
