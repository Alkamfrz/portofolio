---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects.js';

const allProjects = projects;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": allProjects.map((p, i) => ({
    "@type": "CreativeWork", "position": i + 1, "name": p.title,
    "description": p.description, "url": p.liveUrl || p.journalUrl || p.githubUrl || '',
    "keywords": p.techStack.join(", "), "author": { "@type": "Person", "name": "Muhammad Alkam Alfariz" }
  }))
};
---

<Layout title="Projects" description="Selected projects — infrastructure, computer vision, and automation.">
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

<section aria-labelledby="projects-title">
  <span class="section-label">Projects</span>
  <h1 id="projects-title" class="text-3xl mb-8">All Work</h1>

  {allProjects.length === 0 ? (
    <p class="text-sm" style="color: var(--color-text-muted);">No projects yet.</p>
  ) : (
    <div class="flex flex-col gap-6">
      {allProjects.map(p => (
        <article class="card">
          <div class="flex items-start justify-between gap-2 mb-1">
            <h2 class="text-xl font-semibold" style="font-family: var(--font-serif);">{p.title}</h2>
            {p.status && <span class={`status ${p.status}`}>{p.status}</span>}
          </div>
          {p.subtitle && <div class="text-sm mb-2" style="color: var(--color-accent);">{p.subtitle}</div>}
          {p.date && <div class="text-xs mb-3" style="color: var(--color-text-muted); font-family: var(--font-mono);">{p.date}</div>}
          <p class="text-sm mb-4 measure" style="color: var(--color-text-secondary);">{p.description}</p>
          <div class="flex flex-wrap gap-1.5 mb-4">
            {p.techStack.map(t => <span class="tag">{t}</span>)}
          </div>
          <div class="flex flex-wrap gap-2">
            {p.githubUrl && <a href={p.githubUrl} class="btn btn-outline" style="padding:0.3rem 0.75rem; font-size:var(--text-xs);" target="_blank" rel="noopener noreferrer">GitHub</a>}
            {p.journalUrl && <a href={p.journalUrl} class="btn btn-outline" style="padding:0.3rem 0.75rem; font-size:var(--text-xs);" target="_blank" rel="noopener noreferrer">Journal</a>}
            {p.liveUrl && <a href={p.liveUrl} class="btn btn-outline" style="padding:0.3rem 0.75rem; font-size:var(--text-xs);" target="_blank" rel="noopener noreferrer">Live</a>}
          </div>
        </article>
      ))}
    </div>
  )}
</section>
</Layout>
