---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { projects } from '../data/projects.js';
import { skills } from '../data/skills.js';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const recentPosts = [...allPosts]
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 2);

const featuredProjects = projects.filter(p => p.featured).slice(0, 3);

const totalProjects = projects.length;
const activeProjects = projects.filter(p => p.status === 'active').length;
const totalSkills = Object.values(skills).flat().length;
const skillCategories = Object.keys(skills).length;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "name": "Alkamfrz Portfolio", "url": "https://alkamfrz.id", "author": { "@type": "Person", "name": "Muhammad Alkam Alfariz" } },
    { "@type": "Person", "@id": "https://alkamfrz.id/#person", "name": "Muhammad Alkam Alfariz", "givenName": "Muhammad Alkam", "familyName": "Alfariz", "url": "https://alkamfrz.id", "sameAs": ["https://github.com/alkamfrz", "https://linkedin.com/in/alkamfrz"] },
    { "@type": "ProfilePage", "@id": "https://alkamfrz.id/#profilepage", "url": "https://alkamfrz.id", "mainEntity": { "@id": "https://alkamfrz.id/#person" } }
  ]
};
---

<Layout title="Home" description="Muhammad Alkam Alfariz – Informatics Engineering graduate specializing in IT infrastructure, automation, and systems.">
  <script type="application/ld+json">{JSON.stringify(jsonLd)}</script>

  <!-- ==================== HERO ==================== -->
  <section class="terminal-hero" aria-labelledby="hero-heading">
    <div class="container">
      <pre class="hero-banner"><span class="hl-green">  ╔══════════════════════════════════════════╗</span>
<span class="hl-green">  ║</span>  <span class="hl-cyan">______     _                     __   </span>  <span class="hl-green">║</span>
<span class="hl-green">  ║</span>  <span class="hl-cyan">|  _  \   | |                   / _|  </span>  <span class="hl-green">║</span>
<span class="hl-green">  ║</span>  <span class="hl-cyan">| | | | __| | __ _  ___  ___   | |_   </span>  <span class="hl-green">║</span>
<span class="hl-green">  ║</span>  <span class="hl-cyan">| | | |/ _` |/ _` |/ _ \/ __|  |  _|  </span>  <span class="hl-green">║</span>
<span class="hl-green">  ║</span>  <span class="hl-cyan">| |/ / (_| | (_| |  __/\__ \  | |    </span>  <span class="hl-green">║</span>
<span class="hl-green">  ║</span>  <span class="hl-cyan">|___/ \__,_|\__, |\___||___/  |_|    </span>  <span class="hl-green">║</span>
<span class="hl-green">  ║</span>  <span class="hl-cyan">             __/ |                    </span>  <span class="hl-green">║</span>
<span class="hl-green">  ║</span>  <span class="hl-cyan">            |___/                     </span>  <span class="hl-green">║</span>
<span class="hl-green">  ║</span>  <span class="hl-amber">    Infrastructure &amp; Systems Engineer </span>  <span class="hl-green">║</span>
<span class="hl-green">  ╚══════════════════════════════════════════╝</span></pre>

      <h1 id="hero-heading" class="hero-headline">
        <span class="hl-green">$</span> whoami<br>
        <span class="hl-cyan">Muhammad Alkam Alfariz</span>
      </h1>

      <p class="hero-description">
        Informatics Engineering graduate from Universitas Mercu Buana (GPA 3.90/4.00).
        Specializing in IT infrastructure, network optimization, computer vision research,
        and AI-driven automation.
      </p>

      <div class="metrics-bar">
        <div class="metric-item">
          <span class="metric-label">projects</span>
          <span class="metric-value">{totalProjects}</span>
        </div>
        <div class="metric-item">
          <span class="metric-label">active</span>
          <span class="metric-value">{activeProjects}</span>
        </div>
        <div class="metric-item">
          <span class="metric-label">skills</span>
          <span class="metric-value">{totalSkills}</span>
        </div>
        <div class="metric-item">
          <span class="metric-label">categories</span>
          <span class="metric-value">{skillCategories}</span>
        </div>
      </div>

      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a href="#projects" class="btn btn-primary">View Projects</a>
        <a href="#blog" class="btn btn-secondary">Read Blog</a>
        <a href="/CV_Muhammad_Alkam_Alfariz.pdf" class="btn btn-cv" download>Download CV</a>
      </div>
    </div>
  </section>

  <div class="section-divider">
    <div class="section-divider-terminal">
      <span class="line"></span>
      <span>~$ cd about</span>
      <span class="line"></span>
    </div>
  </div>

  <!-- ==================== ABOUT ==================== -->
  <section id="about" class="section" aria-labelledby="about-heading">
    <div class="container">
      <h2 id="about-heading" class="section-title">About</h2>
      <p class="section-subtitle">whoami — current user profile</p>

      <div class="term-card" style="padding: 1.5rem;">
        <div class="about-grid">
          <div>
            <div class="terminal-line"><span class="prompt">$</span> cat profile.txt</div>
            <div class="terminal-line" style="margin-top: 0.5rem;">
              Versatile Informatics Engineering graduate from Universitas Mercu Buana (3.90/4.00)<br>
              with proven expertise in IT infrastructure, system automation, and<br>
              cross-platform development. Experienced with homelab deployments,<br>
              Docker Compose stacks, computer vision research, and CI/CD pipelines.
            </div>
            <div class="terminal-line" style="margin-top: 0.75rem;">
              <span class="prompt">$</span> echo <span style="color: var(--accent-amber);">$EDUCATION</span><br>
              <span style="color: var(--accent-cyan);">→</span> S.Kom. — Informatics Engineering<br>
              <span style="color: var(--accent-cyan);">→</span> Universitas Mercu Buana
            </div>
          </div>
          <div>
            <div class="terminal-line"><span class="prompt">$</span> cat certs.txt</div>
            <div class="terminal-line" style="margin-top: 0.5rem; color: var(--accent-cyan);">
              → Google IT Automation with Python (Coursera)<br>
              → Belajar Jaringan Komputer untuk Pemula (Codepolitan)<br>
              → Memulai Pemrograman dengan Python (Dicoding)<br>
              → Belajar Dasar-Dasar DevOps (Dicoding)
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="section-divider">
    <div class="section-divider-terminal">
      <span class="line"></span>
      <span>~$ ls skills/</span>
      <span class="line"></span>
    </div>
  </div>

  <!-- ==================== SKILLS ==================== -->
  <section id="skills" class="section" aria-labelledby="skills-heading">
    <div class="container">
      <h2 id="skills-heading" class="section-title">Skills</h2>
      <p class="section-subtitle">ls -la ~/tech-stack/</p>

      <div class="term-card" style="padding: 1.25rem;">
        <div class="skills-tree">
          <span class="tree-node"><span class="tree-pipe">.</span></span>
          <span class="tree-node"><span class="tree-pipe">├──</span> <span class="tree-dir">languages/</span> <span class="tree-file">{skills.languages.join(', ')}</span></span>
          <span class="tree-node"><span class="tree-pipe">├──</span> <span class="tree-dir">databases/</span> <span class="tree-file">{skills.databases.join(', ')}</span></span>
          <span class="tree-node"><span class="tree-pipe">├──</span> <span class="tree-dir">infrastructure/</span> <span class="tree-file">{skills.infrastructure.join(', ')}</span></span>
          <span class="tree-node"><span class="tree-pipe">├──</span> <span class="tree-dir">security/</span> <span class="tree-file">{skills.security.join(', ')}</span></span>
          <span class="tree-node"><span class="tree-pipe">├──</span> <span class="tree-dir">systems/</span> <span class="tree-file">{skills.systems.join(', ')}</span></span>
          <span class="tree-node"><span class="tree-pipe">└──</span> <span class="tree-dir">softskills/</span> <span class="tree-file">{skills.softskills.join(', ')}</span></span>
        </div>
      </div>
    </div>
  </section>

  <div class="section-divider">
    <div class="section-divider-terminal">
      <span class="line"></span>
      <span>~$ git log --oneline</span>
      <span class="line"></span>
    </div>
  </div>

  <!-- ==================== EXPERIENCE ==================== -->
  <section id="experience" class="section" aria-labelledby="exp-heading">
    <div class="container">
      <h2 id="exp-heading" class="section-title">Experience</h2>
      <p class="section-subtitle">git log --oneline --reverse</p>

      <div class="term-card" style="padding: 1.25rem;">
        <div class="git-timeline">
          <div class="timeline-item">
            <span class="timeline-hash">a1b2c3d</span>
            <span class="timeline-date">2025-01</span>
            <span class="timeline-ref">INFRASTRUCTURE ENGINEER</span>
            <span class="timeline-msg">Homelab deployment & automation — Proxmox, Docker, HAProxy, Tailscale</span>
          </div>
          <div class="timeline-item">
            <span class="timeline-hash">e4f5g6h</span>
            <span class="timeline-date">2024-09</span>
            <span class="timeline-ref">COMPUTER VISION RESEARCH</span>
            <span class="timeline-msg">RetinaNet oil palm ripeness detection — PyTorch, published on Garuda</span>
          </div>
          <div class="timeline-item">
            <span class="timeline-hash">i7j8k9l</span>
            <span class="timeline-date">2024-03</span>
            <span class="timeline-ref">NETWORK ENGINEER INTERN</span>
            <span class="timeline-msg">MikroTik routing, VLAN segmentation, firewall policy, CCTV infrastructure</span>
          </div>
          <div class="timeline-item">
            <span class="timeline-hash">m0n1o2p</span>
            <span class="timeline-date">2023-06</span>
            <span class="timeline-ref">FREELANCE IT SUPPORT</span>
            <span class="timeline-msg">Active Directory, network troubleshooting, hardware provisioning, SOP docs</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="section-divider">
    <div class="section-divider-terminal">
      <span class="line"></span>
      <span>~$ ls projects/</span>
      <span class="line"></span>
    </div>
  </div>

  <!-- ==================== FEATURED PROJECTS ==================== -->
  <section id="projects" class="section" aria-labelledby="projects-heading">
    <div class="container">
      <h2 id="projects-heading" class="section-title">Featured Projects</h2>
      <p class="section-subtitle">cat projects.json | jq '.featured'</p>

      {featuredProjects.length === 0 ? (
        <p class="empty-state">No featured projects found</p>
      ) : (
        <div class="projects-grid">
          {featuredProjects.map((project, idx) => (
            <article class="term-card project-card reveal reveal-delay-{(idx % 3) + 1}" data-tags={project.techStack.join(',')}>
              <div class="project-card-header">
                <h3 class="project-title">{project.title}</h3>
                {project.status && <span class={`status-badge ${project.status}`}>{project.status}</span>}
              </div>
              {project.date && <span class="project-date">{project.date}</span>}
              <p class="project-desc">{project.description}</p>
              <div class="tech-badges">
                {project.techStack.map(tech => <span class="tech-badge">{tech}</span>)}
              </div>
              <div class="project-links">
                {project.githubUrl && <a href={project.githubUrl} class="project-link github-link" target="_blank" rel="noopener noreferrer">github</a>}
                {project.journalUrl && <a href={project.journalUrl} class="project-link journal-link" target="_blank" rel="noopener noreferrer">journal</a>}
                {project.liveUrl && <a href={project.liveUrl} class="project-link live-link" target="_blank" rel="noopener noreferrer">live</a>}
              </div>
            </article>
          ))}
        </div>
      )}

      <div style="text-align: center; margin-top: 2rem;">
        <a href="/projects/" class="btn btn-secondary btn-sm">view all projects →</a>
      </div>
    </div>
  </section>

  <div class="section-divider">
    <div class="section-divider-terminal">
      <span class="line"></span>
      <span>~$ cat /var/log/blog</span>
      <span class="line"></span>
    </div>
  </div>

  <!-- ==================== BLOG ==================== -->
  <section id="blog" class="section blog-preview-section" aria-labelledby="blog-heading">
    <div class="container">
      <h2 id="blog-heading" class="section-title">Latest Posts</h2>
      <p class="section-subtitle">tail -n 2 /var/log/blog</p>

      {recentPosts.length === 0 ? (
        <p class="empty-state">No posts yet</p>
      ) : (
        <div class="blog-grid">
          {recentPosts.map(post => {
            const words = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : 0;
            const readingTime = Math.max(1, Math.ceil(words / 200));
            return (
            <a href={`/blog/${post.id}`} class="term-card blog-card blog-post-card" style="text-decoration: none;">
              <h3 class="post-title">{post.data.title}</h3>
              <div class="post-meta">
                <span>{post.data.date}</span>
                <span>{readingTime} min read</span>
              </div>
              <p class="post-desc">{post.data.description}</p>
              <span class="read-more">read more →</span>
            </a>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <div class="section-divider">
    <div class="section-divider-terminal">
      <span class="line"></span>
      <span>~$ nc contact 443</span>
      <span class="line"></span>
    </div>
  </div>

  <!-- ==================== CONTACT ==================== -->
  <section id="contact" class="section" aria-labelledby="contact-heading">
    <div class="container">
      <h2 id="contact-heading" class="section-title">Contact</h2>
      <p class="section-subtitle">echo $MESSAGE | nc alkamfrz.id 443</p>

      <div class="term-card" style="padding: 1.5rem; max-width: 500px;">
        <form id="contact-form" class="contact-form" novalidate>
          <div class="form-group">
            <label for="contact-name" class="form-label">name</label>
            <input type="text" id="contact-name" name="name" class="form-input" placeholder="your name" required />
            <small class="form-error" id="name-error" data-error="name"></small>
          </div>
          <div class="form-group">
            <label for="contact-email" class="form-label">email</label>
            <input type="email" id="contact-email" name="email" class="form-input" placeholder="you@example.com" required />
            <small class="form-error" id="email-error" data-error="email"></small>
          </div>
          <div class="form-group">
            <label for="contact-message" class="form-label">message</label>
            <textarea id="contact-message" name="message" class="form-textarea" placeholder="your message here..." required></textarea>
            <small class="form-error" id="message-error" data-error="message"></small>
          </div>
          <div id="contact-status" data-status class="form-status"></div>
          <button type="submit" id="contact-submit" class="btn btn-primary btn-sm" style="width: 100%; justify-content: center;">Send</button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Contact form — load async (not render-blocking)
  import('../components/contact-form.js');
</script>
