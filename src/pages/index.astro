---
import Layout from '../layouts/Layout.astro';
import { experience, education, certifications, skills, projects } from '../data/index.js';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const recentPosts = [...allPosts]
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

function fmtDate(d) {
  try {
    return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  } catch { return d; }
}

function fmtYear(d) {
  try {
    return new Date(d).toLocaleDateString('en-US', { year: 'numeric' });
  } catch { return d; }
}
---

<Layout title="Home" description="Muhammad Alkam Alfariz — Infrastructure Engineer specializing in IT automation, homelab systems, and computer vision.">

  <!-- ── Hero ── -->
  <section id="about" aria-labelledby="hero-title">
    <p class="hero-eyebrow">Infrastructure Engineer · Tangerang, Indonesia</p>
    <h1 class="hero-title" id="hero-title">
      Building systems<br>that last.
    </h1>
    <p class="hero-lede">
      Informatics Engineering graduate (GPA&nbsp;3.90/4.00) specializing in IT infrastructure,
      system automation, and computer vision. Currently at Sinarmas Multifinance —
      previously at Halodoc and EMTEK Group. I build homelabs, write automation scripts,
      and publish research on deep learning for agriculture.
    </p>
    <div class="hero-actions">
      <a href="/CV_Muhammad_Alkam_Alfariz.pdf" class="btn btn-primary" download>Download CV</a>
      <a href="#experience" class="btn btn-outline">View experience</a>
      <a href="#projects" class="btn btn-ghost">See projects →</a>
    </div>
  </section>

  <!-- ── About quick facts ── -->
  <section aria-labelledby="about-title">
    <header class="section-header">
      <span class="section-num">01</span>
      <span class="section-title" id="about-title">About</span>
    </header>

    <div class="about-grid">
      <div>
        <p>
          I approach infrastructure as software — repeatable, version-controlled,
          and observable. My work spans from bare-metal Proxmox deployments
          to CNN-based computer vision pipelines, unified by a focus on reliability
          and operational simplicity.
        </p>
        <p>
          Outside of work I maintain a homelab that runs 15+ services, contribute
          to open tooling for homelab automation, and write about self-hosting on this blog.
        </p>
      </div>
      <div>
        {education.map(e => (
          <div class="about-stat">
            <div class="about-stat-value">{e.gpa}</div>
            <div class="about-stat-label">{e.degree}</div>
            <div style="font-size: var(--text-xs); color: var(--text-muted);">{e.school} · {e.location}</div>
          </div>
        ))}
        <div class="about-stat">
          <div style="font-size: var(--text-xs); color: var(--text-muted); margin-bottom: 0.5rem;">Certifications</div>
          <ul class="cert-list">
            {certifications.map(c => <li>{c}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Experience ── -->
  <section id="experience" aria-labelledby="exp-title">
    <header class="section-header">
      <span class="section-num">02</span>
      <span class="section-title" id="exp-title">Experience</span>
    </header>

    {experience.map(job => (
      <article class="entry" aria-label={job.role}>
        <div class="entry-header">
          <div>
            <div class="entry-meta">
              <span class="entry-org">{job.org}</span>
              <span class="entry-period">{job.period}</span>
            </div>
            <h3 class="entry-title">{job.role}</h3>
          </div>
          <span class="status-dot active">Current</span>
        </div>
        <p class="entry-desc">{job.description}</p>
        <ul class="entry-achievements">
          {job.achievements.map(a => <li>{a}</li>)}
        </ul>
      </article>
    ))}
  </section>

  <!-- ── Projects ── -->
  <section id="projects" aria-labelledby="proj-title">
    <header class="section-header">
      <span class="section-num">03</span>
      <span class="section-title" id="proj-title">Projects</span>
    </header>

    <div class="project-grid">
      {projects.map((p, i) => (
        <div class="project-card">
          <div class="project-card-num">0{i + 1}</div>
          <div class="project-card-header">
            <h3 class="project-card-title">{p.title}</h3>
            <span class={`status-dot ${p.status}`}>{p.status}</span>
          </div>
          <p class="project-card-desc">{p.description}</p>
          <div class="entry-tags">
            {p.tech.map(t => <span class="tag">{t}</span>)}
          </div>
          <div class="project-card-links">
            {p.github && <a href={p.github} class="btn btn-ghost btn-sm" target="_blank" rel="noopener noreferrer">GitHub</a>}
            {p.live && <a href={p.live} class="btn btn-ghost btn-sm" target="_blank" rel="noopener noreferrer">Live →</a>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Skills ── -->
  <section id="skills" aria-labelledby="skills-title">
    <header class="section-header">
      <span class="section-num">04</span>
      <span class="section-title" id="skills-title">Skills</span>
    </header>

    <div>
      {Object.entries(skills).map(([group, items]) => (
        <div class="skills-group">
          <div class="skills-group-label">{group}</div>
          <div class="skills-tags">
            {items.map(item => <span class="tag">{item}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Writing ── -->
  <section id="writing" aria-labelledby="writing-title">
    <header class="section-header">
      <span class="section-num">05</span>
      <span class="section-title" id="writing-title">Writing</span>
    </header>

    {recentPosts.length === 0 ? (
      <p style="color: var(--text-muted);">No posts yet.</p>
    ) : (
      <div class="writing-list" role="list">
        {recentPosts.map(post => {
          const wc = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : 0;
          const rt = Math.max(1, Math.ceil(wc / 200));
          return (
            <a href={`/blog/${post.id}`} class="writing-item" role="listitem">
              <div class="writing-date">{fmtDate(post.data.date)}</div>
              <div>
                <h3 class="writing-title">{post.data.title}</h3>
                <div class="writing-meta">{rt} min read</div>
                <p class="writing-excerpt">{post.data.description}</p>
              </div>
            </a>
          );
        })}
      </div>
    )}

    <div style="margin-top: 1.5rem;">
      <a href="/blog/" class="btn btn-outline">All posts →</a>
    </div>
  </section>

  <!-- ── Contact ── -->
  <section id="contact" aria-labelledby="contact-title">
    <header class="section-header">
      <span class="section-num">06</span>
      <span class="section-title" id="contact-title">Contact</span>
    </header>

    <div class="contact-grid">
      <div>
        <p>
          Open to infrastructure, DevOps, and automation roles.
          Feel free to reach out — I typically respond within 48 hours.
        </p>
        <p>
          <a href="mailto:alkamfrz@gmail.com">alkamfrz@gmail.com</a><br>
          <a href="https://linkedin.com/in/alkamfrz" target="_blank" rel="noopener noreferrer">linkedin.com/in/alkamfrz</a><br>
          <a href="https://github.com/alkamfrz" target="_blank" rel="noopener noreferrer">github.com/alkamfrz</a>
        </p>
      </div>

      <form id="contact-form" novalidate aria-label="Contact form">
        <div class="form-group">
          <label for="contact-name" class="form-label">Name</label>
          <input type="text" id="contact-name" name="name" class="form-input" placeholder="Your name" required autocomplete="name" />
          <span class="form-error" id="name-error"></span>
        </div>
        <div class="form-group">
          <label for="contact-email" class="form-label">Email</label>
          <input type="email" id="contact-email" name="email" class="form-input" placeholder="you@example.com" required autocomplete="email" />
          <span class="form-error" id="email-error"></span>
        </div>
        <div class="form-group">
          <label for="contact-message" class="form-label">Message</label>
          <textarea id="contact-message" name="message" class="form-textarea" placeholder="Your message..." required></textarea>
          <span class="form-error" id="message-error"></span>
        </div>
        <div id="contact-status" class="form-status" role="status" aria-live="polite"></div>
        <button type="submit" id="contact-submit" class="btn btn-primary">Send message</button>
      </form>
    </div>
  </section>

</Layout>

<script>
  (function() {
    var form = document.getElementById('contact-form');
    if (!form) return;
    var fields = {
      name: form.querySelector('[name="name"]'),
      email: form.querySelector('[name="email"]'),
      message: form.querySelector('[name="message"]'),
    };
    var errors = {
      name: document.getElementById('name-error'),
      email: document.getElementById('email-error'),
      message: document.getElementById('message-error'),
    };
    var statusEl = document.getElementById('contact-status');
    var submitBtn = form.querySelector('[type="submit"]');

    function clearErrors() {
      Object.values(errors).forEach(function(e) { if (e) e.textContent = ''; });
      if (statusEl) { statusEl.textContent = ''; statusEl.className = 'form-status'; }
    }

    function validate() {
      clearErrors();
      var valid = true;
      if (!fields.name.value.trim()) {
        if (errors.name) errors.name.textContent = 'Name is required.';
        valid = false;
      }
      if (!fields.email.value.trim()) {
        if (errors.email) errors.email.textContent = 'Email is required.';
        valid = false;
      } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(fields.email.value.trim())) {
        if (errors.email) errors.email.textContent = 'Enter a valid email address.';
        valid = false;
      }
      if (!fields.message.value.trim()) {
        if (errors.message) errors.message.textContent = 'Message is required.';
        valid = false;
      }
      return valid;
    }

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      if (!validate()) return;
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending...'; }

      try {
        var resp = await fetch('https://formspree.io/f/meoegore', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: fields.name.value.trim(),
            email: fields.email.value.trim(),
            message: fields.message.value.trim(),
          }),
        });
        if (resp.ok) {
          if (statusEl) { statusEl.textContent = 'Message sent. I\'ll be in touch soon.'; statusEl.className = 'form-status success'; }
          form.reset();
        } else if (resp.status === 429) {
          if (statusEl) { statusEl.textContent = 'Too many requests. Please wait.'; statusEl.className = 'form-status error'; }
        } else {
          if (statusEl) { statusEl.textContent = 'Something went wrong. Try again.'; statusEl.className = 'form-status error'; }
        }
      } catch(err) {
        if (statusEl) { statusEl.textContent = 'Network error. Try emailing directly.'; statusEl.className = 'form-status error'; }
      }
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Send message'; }
    });
  })();
</script>
