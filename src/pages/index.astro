---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.jsx';
import { projects } from '../data/projects.js';
import { skills } from '../data/skills.js';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const recentPosts = [...allPosts]
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 2);

const featuredProjects = projects.filter(p => p.featured).slice(0, 3);
const hiddenCategoryCount = Object.keys(skills).length - 2;

function formatDate(dateStr) {
  try {
    const date = new Date(dateStr);
    if (isNaN(date.getTime())) return '';
    return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
  } catch { return ''; }
}

const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "Alkamfrz Portfolio",
      "url": "https://alkamfrz.my.id",
      "author": { "@type": "Person", "name": "Muhammad Alkam Alfariz" },
      "description": "Muhammad Alkam Alfariz – Informatics Engineering graduate specializing in IT infrastructure, automation, and systems."
    },
    {
      "@type": "Person",
      "name": "Muhammad Alkam Alfariz",
      "givenName": "Muhammad Alkam",
      "familyName": "Alfariz",
      "alumniOf": "Universitas Mercu Buana",
      "url": "https://alkamfrz.my.id",
      "sameAs": ["https://github.com/alkamfrz", "https://linkedin.com/in/alkamfrz"]
    }
  ]
};
const categoryTitles = {
  languages: 'Programming Languages',
  databases: 'Database Management',
  infrastructure: 'DevOps & Infrastructure',
  observability: 'Observability & Monitoring',
  systems: 'Operating Systems & Tools',
  softskills: 'Soft Skills & Leadership'
};
---

<Layout title="Home">
  <script type="application/ld+json">{JSON.stringify(homeJsonLd)}</script>

  <!-- =================== HERO =================== -->
  <section id="hero" class="hero-section" aria-labelledby="hero-heading">
    <div class="hero-content">
      <p class="hero-eyebrow">Hello, I'm</p>
      <hgroup>
        <h1 id="hero-heading" class="hero-title reveal">
          <span class="text-gradient">Muhammad Alkam Alfariz</span>
        </h1>
        <p class="hero-subtitle reveal reveal-delay-1">Informatics Engineer | IT Infrastructure &amp; Automation</p>
      </hgroup>
      <p class="hero-description reveal reveal-delay-2">
        Versatile Informatics Engineering graduate from Universitas Mercu Buana specializing in IT infrastructure, network optimization, computer vision research, and AI-driven automation.
      </p>
      <div class="hero-ctas reveal reveal-delay-3">
        <a href="#projects" class="btn btn-primary btn-pulse">View Projects</a>
        <a href="#blog" class="btn btn-secondary">Read Blog</a>
        <a href="/CV_Muhammad_Alkam_Alfariz.pdf" class="btn btn-cv" download>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px; vertical-align: middle;" aria-hidden="true" role="img">
            <title>Download</title>
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Download CV
        </a>
      </div>
    </div>
    <div class="scroll-indicator" aria-hidden="true">
      <span>Scroll</span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" role="img">
        <title>Scroll down</title>
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </div>
  </section>

  <!-- =================== ABOUT =================== -->
  <section id="about" class="section" aria-labelledby="about-heading">
    <div class="section-container">
      <h2 id="about-heading" class="section-title text-gradient">About Me</h2>
      <div class="glass-card about-card card-accent">
        <p class="about-text">
          I'm a versatile Informatics Engineering graduate from Universitas Mercu Buana (GPA 3.90/4.00) with proven expertise in IT infrastructure, system automation, and cross-platform integrations. I am proficient in scripting workflows using Python (BERT-NLP, computer vision) and PowerShell, managing relational databases, and configuring central monitoring platforms like ZoneMinder and Zabbix.
        </p>
        <p class="about-text">
          Beyond IT support, I run an advanced self-hosted homelab stack including Proxmox VE virtualization, Docker Compose, HAProxy routing, Cloudflare Tunnels, and Prometheus/Grafana/Loki/Zabbix observability suites. My engineering philosophy is built around data ownership, automating repetitive tasks, and robust system monitoring.
        </p>
        <div class="bio-highlights">
          <div class="bio-highlight">
            <span class="highlight-label">Degree</span>
            <span class="highlight-val">B.Eng. Informatics</span>
          </div>
          <div class="bio-highlight">
            <span class="highlight-label">GPA</span>
            <span class="highlight-val">3.90 / 4.00</span>
          </div>
          <div class="bio-highlight">
            <span class="highlight-label">Location</span>
            <span class="highlight-val">Tangerang, ID</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =================== SKILLS =================== -->
  <section id="skills" class="section" aria-labelledby="skills-heading">
    <div class="section-container">
      <h2 id="skills-heading" class="section-title text-gradient">Skills &amp; Technologies</h2>
      <div class="skills-grid" id="skills-grid">
        {Object.entries(skills).slice(0, 2).map(([category, items], catIdx) => {
          return (
          <div class={`glass-card skill-category reveal-left ${catIdx === 0 ? 'reveal-delay-1' : 'reveal-delay-2'}`} style="padding: 1.25rem;">
            <h3 class="skill-category-title" style="font-size: 0.9rem; margin-bottom: 0.75rem;">{categoryTitles[category] || category}</h3>
            <div class="skill-badges">
              {items.map((skill, sIdx) => {
                const levels = ['advanced', 'expert', 'proficient', 'advanced'];
                const level = levels[sIdx % levels.length];
                return (
                  <span class={`skill-badge skill-level-${level}`} style="font-size: 0.8rem; padding: 0.2rem 0.6rem;" title={level.charAt(0).toUpperCase() + level.slice(1)}>{skill}</span>
                );
              })}
            </div>
          </div>
          );
        })}
        {Object.entries(skills).slice(2).map(([category, items], catIdx) => {
          return (
          <div class={`glass-card skill-category skill-hidden reveal-left ${catIdx === 0 ? 'reveal-delay-3' : catIdx === 1 ? 'reveal-delay-4' : 'reveal-delay-5'}`} style="padding: 1.25rem;">
            <h3 class="skill-category-title" style="font-size: 0.9rem; margin-bottom: 0.75rem;">{categoryTitles[category] || category}</h3>
            <div class="skill-badges">
              {items.map((skill, sIdx) => {
                const levels = ['advanced', 'expert', 'proficient', 'advanced'];
                const level = levels[sIdx % levels.length];
                return (
                  <span class={`skill-badge skill-level-${level}`} style="font-size: 0.8rem; padding: 0.2rem 0.6rem;" title={level.charAt(0).toUpperCase() + level.slice(1)}>{skill}</span>
                );
              })}
            </div>
          </div>
          );
        })}
      </div>
      {hiddenCategoryCount > 0 && (
      <div class="skills-toggle-wrapper">
        <button class="skills-toggle-btn" id="skills-toggle-btn" data-expanded="false" data-count={hiddenCategoryCount} aria-expanded="false">
          Show {hiddenCategoryCount} more categories ▾
        </button>
      </div>
      )}
    </div>
  </section>

  <!-- =================== EXPERIENCE =================== -->
  <section id="experience" class="section" aria-labelledby="experience-heading">
    <div class="section-container">
      <h2 id="experience-heading" class="section-title text-gradient">Experience &amp; Education</h2>

      <div class="experience-container" style="margin-top: 0;">
        <div class="timeline">
          <div class="timeline-item reveal-left reveal-delay-1">
            <div class="timeline-dot"></div>
            <div class="timeline-content glass-card glow-hover">
              <span class="timeline-badge badge-work">💼 Work</span>
              <span class="timeline-date">May 2025 - Present</span>
              <h4 class="timeline-role">IT Hardware Support Internship</h4>
              <h5 class="timeline-company">Sinarmas Multifinance</h5>
              <p class="timeline-desc">Managed workstations, DVR systems, and access management across multiple OS.</p>
              <div class="timeline-details">
                <ul class="timeline-points">
                <li>Performed Windows 11, Linux openSUSE 15.6, and macOS Sequoia installations across 40+ workstations.</li>
                <li>Configured DVR systems with ZoneMinder, establishing centralized 24/7 monitoring for 15+ cameras.</li>
                <li>Managed Active Directory accounts and OpenVPN configurations for 200+ employees.</li>
              </ul>
              </div>
              <button class="timeline-details-btn" aria-expanded="false">Show details ▾</button>
            </div>
          </div>

          <div class="timeline-item reveal-left reveal-delay-2">
            <div class="timeline-dot"></div>
            <div class="timeline-content glass-card glow-hover">
              <span class="timeline-badge badge-work">💼 Work</span>
              <span class="timeline-date">Sep 2024 - Dec 2024</span>
              <h4 class="timeline-role">IT Support Internship</h4>
              <h5 class="timeline-company">EMTEK Group (RS EMC Alam Sutera)</h5>
              <p class="timeline-desc">Optimized hospital network systems and automated compliance audits.</p>
              <div class="timeline-details">
                <ul class="timeline-points">
                <li>Deployed 50+ IoT devices/APs, reducing network downtime via custom monitoring scripts.</li>
                <li>Automated audit logging with Python (fuzzy search &amp; NLP), saving 15 manual hours/week.</li>
                <li>Upgraded 30+ HDDs to SSDs and crimped 150+ Cat6 cables with 99% uptime.</li>
              </ul>
              </div>
              <button class="timeline-details-btn" aria-expanded="false">Show details ▾</button>
            </div>
          </div>

          <div class="timeline-item reveal-left reveal-delay-3">
            <div class="timeline-dot"></div>
            <div class="timeline-content glass-card glow-hover">
              <span class="timeline-badge badge-work">💼 Work</span>
              <span class="timeline-date">Feb 2024 - Jun 2024</span>
              <h4 class="timeline-role">Tech IT Infrastructure Internship</h4>
              <h5 class="timeline-company">Halodoc (PT Media Dokter Investama)</h5>
              <p class="timeline-desc">Resolved hardware/software incidents and automated compliance purging.</p>
              <div class="timeline-details">
                <ul class="timeline-points">
                <li>Resolved 15–20 weekly incidents, reducing resolution time from 2.5h to 1.6h (35% reduction).</li>
                <li>Integrated Zabbix-Jira to auto-generate tickets, ensuring 100% SLA compliance.</li>
                <li>Built PowerShell scripts to purge non-compliant files on reboot, saving 6 hours/week.</li>
              </ul>
              </div>
              <button class="timeline-details-btn" aria-expanded="false">Show details ▾</button>
            </div>
          </div>

          <div class="timeline-break">
            <span>🎓 Education</span>
          </div>

          <div class="timeline-item reveal-left reveal-delay-4">
            <div class="timeline-dot edu-dot"></div>
            <div class="timeline-content glass-card glow-hover">
              <span class="timeline-badge badge-edu">🎓 Education</span>
              <span class="timeline-date">Aug 2021 - Aug 2025</span>
              <h4 class="timeline-role">Bachelor of Informatics Engineering</h4>
              <h5 class="timeline-company">Universitas Mercu Buana</h5>
              <p class="timeline-desc">Graduated with a GPA of 3.90/4.00. Active in exhibitions and student association committee.</p>
              <div class="timeline-details">
                <ul class="timeline-points">
                <li>Committee member of the event division for the Informatics Student Association (2021).</li>
                <li>Official host at the UMB Student Work Exhibition event (2022).</li>
              </ul>
              </div>
              <button class="timeline-details-btn" aria-expanded="false">Show details ▾</button>
            </div>
          </div>

          <div class="timeline-item reveal-left reveal-delay-5">
            <div class="timeline-dot edu-dot"></div>
            <div class="timeline-content glass-card glow-hover">
              <span class="timeline-badge badge-edu">🎓 Education</span>
              <span class="timeline-date">Jan 2024 - Dec 2024</span>
              <h4 class="timeline-role">Assistant Coordinator</h4>
              <h5 class="timeline-company">ASLAB Fasilkom UMB</h5>
              <p class="timeline-desc">Managed student assistants and labs, optimized lab hiring workflows.</p>
              <div class="timeline-details">
                <ul class="timeline-points">
                <li>Managed 15–20 assistants across 5 computer labs via Notion scheduling.</li>
                <li>Revamped laboratory hiring using automated Python/network sim tests.</li>
                <li>Built KPI dashboard tracking metrics to cut recurring complaints by 25%.</li>
              </ul>
              </div>
              <button class="timeline-details-btn" aria-expanded="false">Show details ▾</button>
            </div>
          </div>

          <div class="timeline-item reveal-left reveal-delay-6">
            <div class="timeline-dot edu-dot"></div>
            <div class="timeline-content glass-card glow-hover">
              <span class="timeline-badge badge-edu">🎓 Education</span>
              <span class="timeline-date">Jul 2018 - Jul 2021</span>
              <h4 class="timeline-role">High School Diploma</h4>
              <h5 class="timeline-company">SMKN 1 Tangerang</h5>
              <p class="timeline-desc">Computer &amp; Network Engineering. Finalist in Network Infrastructure Competition.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =================== PROJECTS =================== -->
  <section id="projects" class="section" aria-labelledby="projects-heading">
    <div class="section-container">
      <h2 id="projects-heading" class="section-title text-gradient">Featured Projects</h2>
      <div class="featured-projects-wrapper">
        {featuredProjects.map((project, idx) => (
          <article class={`glass-card project-card ${idx === 0 ? 'spotlight' : ''} reveal ${idx > 0 ? `reveal-delay-${idx}` : ''}`}>
            <div class="project-image-wrapper">
              {project.image ? (
                <img src={project.image} alt={project.title} class="project-image" loading="lazy" />
              ) : (
                <div class="project-image-placeholder" aria-hidden="true">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                </div>
              )}
            </div>
            <div class="project-card-header">
              <h3 class="project-title">{project.title}</h3>
              {idx === 0 && <span class="tag-chip">Featured</span>}
            </div>
            <p class="project-desc">{project.description}</p>
            <div class="tech-badges">
              {project.techStack.map(tech => (
                <span class="tech-badge">{tech}</span>
              ))}
            </div>
            <div class="project-links">
              {project.githubUrl && (
                <a href={project.githubUrl} class="github-link" target="_blank" rel="noopener noreferrer">GitHub</a>
              )}
              {project.journalUrl && (
                <a href={project.journalUrl} class="journal-link" target="_blank" rel="noopener noreferrer">Journal</a>
              )}
              {project.liveUrl && (
                <a href={project.liveUrl} class="live-link" target="_blank" rel="noopener noreferrer">Live Demo</a>
              )}
            </div>
          </article>
        ))}
      </div>
      <div class="view-all-wrapper">
        <a href="/projects" class="btn btn-secondary">View All Projects</a>
      </div>
    </div>
  </section>

  <!-- =================== HOMELAB =================== -->
  <section id="homelab" class="section" aria-labelledby="homelab-heading">
    <div class="section-container">
      <h2 id="homelab-heading" class="section-title text-gradient">Homelab Architecture</h2>
      <div class="glass-card topology-card" style="margin: 0; max-width: none;">
        <p class="topology-intro">Hover or tap on a node to trace the secure, zero-trust network data flow.</p>

        <div class="topology-wrapper">
          <div class="topology-diagram">
            <svg viewBox="0 0 800 400" width="100%" height="100%" class="topology-svg">
              <defs>
                <linearGradient id="flow-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="var(--accent-cyan)" />
                  <stop offset="100%" stop-color="var(--accent-purple)" />
                </linearGradient>
                <marker id="arrow" viewBox="0 0 10 10" refX="22" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                  <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--text-muted)" />
                </marker>
                <marker id="arrow-active" viewBox="0 0 10 10" refX="22" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                  <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--accent-cyan)" />
                </marker>
              </defs>

              <path d="M 100 200 L 220 200" class="conn-line flow-1" marker-end="url(#arrow)" />
              <path d="M 220 200 L 360 200" class="conn-line flow-2" marker-end="url(#arrow)" />
              <path d="M 360 200 L 520 120" class="conn-line flow-3" marker-end="url(#arrow)" />
              <path d="M 360 200 L 520 280" class="conn-line flow-4" marker-end="url(#arrow)" />
              <path d="M 520 280 L 680 280" class="conn-line flow-5" marker-end="url(#arrow)" />
              <path d="M 520 120 L 520 280" class="conn-line flow-6" style="stroke-dasharray: 4;" />

              <g class="node-group" data-node="internet" style="cursor: pointer;">
                <circle cx="100" cy="200" r="30" class="node-circle" />
                <circle cx="118" cy="182" r="4" class="node-status-dot" />
                <text x="100" y="204" text-anchor="middle" class="node-text">WAN</text>
              </g>

              <g class="node-group" data-node="cloudflare" style="cursor: pointer;">
                <circle cx="220" cy="200" r="35" class="node-circle" />
                <circle cx="242" cy="178" r="4" class="node-status-dot" />
                <text x="220" y="196" text-anchor="middle" class="node-text">Cloudflare</text>
                <text x="220" y="212" text-anchor="middle" class="node-subtext">Tunnel</text>
              </g>

              <g class="node-group" data-node="haproxy" style="cursor: pointer;">
                <circle cx="360" cy="200" r="35" class="node-circle" />
                <circle cx="382" cy="178" r="4" class="node-status-dot" />
                <text x="360" y="196" text-anchor="middle" class="node-text">HAProxy</text>
                <text x="360" y="212" text-anchor="middle" class="node-subtext">10.1.30.3</text>
              </g>

              <g class="node-group" data-node="proxmox" style="cursor: pointer;">
                <rect x="465" y="75" width="110" height="90" rx="10" class="node-rect" />
                <circle cx="558" cy="88" r="4" class="node-status-dot" />
                <text x="520" y="115" text-anchor="middle" class="node-text">Proxmox VE</text>
                <text x="520" y="135" text-anchor="middle" class="node-subtext">10.1.99.2</text>
              </g>

              <g class="node-group" data-node="docker" style="cursor: pointer;">
                <circle cx="520" cy="280" r="40" class="node-circle" />
                <circle cx="548" cy="254" r="4" class="node-status-dot" />
                <text x="520" y="276" text-anchor="middle" class="node-text">Docker VM</text>
                <text x="520" y="294" text-anchor="middle" class="node-subtext">10.1.30.5</text>
              </g>

              <g class="node-group" data-node="nas" style="cursor: pointer;">
                <rect x="635" y="235" width="90" height="90" rx="10" class="node-rect" />
                <circle cx="710" cy="248" r="4" class="node-status-dot" />
                <text x="680" y="275" text-anchor="middle" class="node-text">TrueNAS</text>
                <text x="680" y="295" text-anchor="middle" class="node-subtext">10.1.30.6</text>
              </g>
            </svg>
          </div>

          <div class="topology-details glass-card" id="node-details-panel" style="min-height: 220px;">
            <h4 class="details-name" id="node-detail-name">Select a Node</h4>
            <p class="details-ip" id="node-detail-ip">Hover or tap on the diagram nodes to inspect details</p>
            <div class="details-divider"></div>
            <p class="details-role" id="node-detail-role">Learn about the role of each device in this self-hosted homelab infrastructure.</p>
            <div class="details-tags" id="node-detail-tags">
              <span class="tech-badge">Interactive</span>
              <span class="tech-badge">Network Map</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =================== BLOG =================== -->
  <section id="blog" class="section" aria-labelledby="blog-heading">
    <div class="section-container">
      <h2 id="blog-heading" class="section-title text-gradient">Latest Posts</h2>
      <div class="blog-grid">
        {recentPosts.map((post, idx) => {
          const wordCount = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : 0;
          const readingTime = Math.max(1, Math.ceil(wordCount / 200));
          return (
          <div class={`glass-card blog-post-card reveal ${idx === 0 ? '' : 'reveal-delay-1'}`}>
            <h3 class="post-title">{post.data.title}</h3>
            <div class="post-meta-row">
              <small class="post-date">{formatDate(post.data.date)}</small>
              <span class="post-reading-time">{readingTime} min read</span>
            </div>
            <p class="post-desc">{post.data.description}</p>
            <a href={`/blog/${post.id}`} class="read-more">Read More &rarr;</a>
          </div>
          );
        })}
      </div>
      <div class="view-all-wrapper">
        <a href="/blog" class="btn btn-secondary">View All Posts</a>
      </div>
    </div>
  </section>

  <!-- =================== CONTACT =================== -->
  <section id="contact" class="section" aria-labelledby="contact-heading">
    <div class="section-container">
      <h2 id="contact-heading" class="section-title text-gradient">Get in Touch</h2>
      <div class="glass-card contact-card">
        <p class="contact-intro">
          Have a project in mind or just want to say hi? Fill out the form below and I'll get back to you.
        </p>
        <ContactForm client:load />
      </div>
    </div>
  </section>

  <script>
    function initHomeInteractions() {
      // --- Homelab Topology Interactions ---
      const nodeDetails = {
        internet: {
          name: 'Public WAN / Internet',
          ip: 'Exposed Edge',
          role: 'Incoming HTTPS web user traffic targeted at alkamfrz.my.id. Traffic is fully secure, TLS-encrypted, and protected by Cloudflare Edge.',
          tags: ['HTTPS', 'TLS 1.3', 'Zero WAN Ports Open']
        },
        cloudflare: {
          name: 'Cloudflare Tunnel (cfd-tng)',
          ip: '10.1.30.2 (LXC)',
          role: 'Establishes a secure, outbound-only tunnel to Cloudflare Edge. Shields your public IP address completely and removes local port-forwarding requirements.',
          tags: ['Zero-Trust', 'Cloudflare Tunnel', 'DNS Proxy']
        },
        haproxy: {
          name: 'HAProxy Reverse Proxy (haproxy-tng)',
          ip: '10.1.30.3 (LXC)',
          role: 'Acts as the central gateway controller. Handles Let\'s Encrypt SSL termination, matches subdomain requests, and ships logs to CrowdSec via syslog UDP.',
          tags: ['Reverse Proxy', 'SSL Termination', 'syslog-relay', 'CrowdSec Bouncer']
        },
        proxmox: {
          name: 'Proxmox VE Hypervisor (pve-tng)',
          ip: '10.1.99.2 (Host)',
          role: 'Debian-based hypervisor managing physical bare-metal hardware. Runs VMs (like the Docker VM) and LXC containers (like HAProxy and DNS) under secure segmentation.',
          tags: ['Hypervisor', 'KVM', 'LXC Containers']
        },
        docker: {
          name: 'Docker VM Host (docker-tng)',
          ip: '10.1.30.5 (VM)',
          role: 'Virtual machine running 11 Docker Compose stacks managed via custom parallel deployment scripts. Runs Portainer EE, Authentik, Immich, Jellyfin, and CrowdSec.',
          tags: ['Docker Compose', 'Portainer EE', 'Live Restore', 'VM Workloads']
        },
        nas: {
          name: 'TrueNAS Shared Storage (NAS-TNG)',
          ip: '10.1.30.6 (NFS)',
          role: 'Central NFS storage server providing persistent shared file systems for all container volumes. Uses local VM SSD cache overrides for low-latency SQLite databases.',
          tags: ['TrueNAS', 'NFS Share', 'RAID Z1', 'Bind Mounts']
        }
      };

      const nodeGroups = document.querySelectorAll('.node-group');
      const nameEl = document.getElementById('node-detail-name');
      const ipEl = document.getElementById('node-detail-ip');
      const roleEl = document.getElementById('node-detail-role');
      const tagsEl = document.getElementById('node-detail-tags');
      const lines = {
        internet: ['.flow-1'],
        cloudflare: ['.flow-1', '.flow-2'],
        haproxy: ['.flow-2', '.flow-3', '.flow-4'],
        proxmox: ['.flow-3', '.flow-6'],
        docker: ['.flow-4', '.flow-5', '.flow-6'],
        nas: ['.flow-5']
      };

      function selectNode(nodeId) {
        const info = nodeDetails[nodeId];
        if (!info) return;

        nameEl.textContent = info.name;
        ipEl.textContent = info.ip;
        roleEl.textContent = info.role;
        tagsEl.innerHTML = info.tags.map(t => `<span class="tech-badge">${t}</span>`).join('');

        document.querySelectorAll('.conn-line').forEach(l => {
          l.classList.remove('active');
          l.setAttribute('marker-end', 'url(#arrow)');
        });

        const activeLines = lines[nodeId] || [];
        activeLines.forEach(selector => {
          const line = document.querySelector(selector);
          if (line) {
            line.classList.add('active');
            line.setAttribute('marker-end', 'url(#arrow-active)');
          }
        });
      }

      nodeGroups.forEach(node => {
        node.addEventListener('mouseenter', () => {
          const nodeId = node.getAttribute('data-node');
          selectNode(nodeId);
        });

        node.addEventListener('click', (e) => {
          e.preventDefault();
          const nodeId = node.getAttribute('data-node');
          selectNode(nodeId);
        });
      });

      // --- Collapsible Skills ---
      const skillsToggle = document.getElementById('skills-toggle-btn');
      const skillsGrid = document.getElementById('skills-grid');
      if (skillsToggle && skillsGrid) {
        skillsToggle.addEventListener('click', () => {
          const expanded = skillsToggle.getAttribute('data-expanded') === 'true';
          skillsToggle.setAttribute('data-expanded', String(!expanded));
          skillsToggle.setAttribute('aria-expanded', String(!expanded));
          skillsGrid.classList.toggle('expanded', !expanded);
          skillsToggle.innerHTML = expanded ? `Show ${skillsToggle.dataset.count || '4'} more categories ▾` : 'Show less ▴';
          if (!expanded) {
            skillsGrid.querySelectorAll('.skill-hidden').forEach((el, i) => {
              setTimeout(() => el.classList.add('visible'), i * 100);
            });
          }
        });
      }

      // --- Compact Timeline Details ---
      document.querySelectorAll('.timeline-details-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const details = btn.closest('.timeline-content').querySelector('.timeline-details');
          if (details) {
            const expanded = details.classList.toggle('expanded');
            btn.setAttribute('aria-expanded', String(expanded));
            btn.textContent = expanded ? 'Hide details ▴' : 'Show details ▾';
          }
        });
      });
    }

    // Run on initial load and after view transitions swap
    initHomeInteractions();
    document.addEventListener('astro:after-swap', initHomeInteractions);
  </script>
</Layout>

