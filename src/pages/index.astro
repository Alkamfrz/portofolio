---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { experience, education, certifications, skills, projects, currentlyBuilding, cv } from '../data/index.js';
---

<Layout title="Home" description="Muhammad Alkam Alfariz — Infrastructure Engineer specializing in IT automation, homelab systems, and computer vision.">

  <!-- ── Hero / About ── -->
  <section id="about" aria-labelledby="hero-title">
    <div class="hero">
      <p class="hero-eyebrow">Activation Specialist · Mekari Qontak · Tangerang, Indonesia</p>
      <h1 class="hero-title" id="hero-title">Systems that stay up.<br>Clients that succeed.</h1>
      <div class="hero-line" aria-hidden="true"></div>
      <p class="hero-lede">
        Infrastructure Engineer who builds homelabs, automates pipelines, and deploys
        production systems — from bare metal to zero-trust VPN. Published researcher in
        computer vision for agriculture and medical imaging.
      </p>
      <div class="hero-meta">
        <a href={currentlyBuilding.url} class="hero-tag" target="_blank" rel="noopener noreferrer">
          <span class="hero-tag-dot"></span>
          {currentlyBuilding.title}
        </a>
      </div>
      <div class="hero-actions">
        <a href={cv.url} class="btn btn-primary" download data-astro-prefetch="false">
          Download CV
        </a>
        {cv.size && <span class="cv-size">{cv.size}</span>}
        <a href="#experience" class="btn btn-outline">
          View experience
        </a>
        <a href="#projects" class="btn btn-ghost">
          See projects →
        </a>
      </div>
    </div>

    <!-- ── About grid ── -->
    <div class="section">
      <div class="section-header">
        <h2 class="section-label">
          <span class="section-label-num">About</span>
        </h2>
      </div>
      <div class="about-grid">
        <div>
          <p>
            I run a production-grade homelab on Proxmox VE — 15+ self-hosted services,
            VLAN-segmented networking, Cloudflare Tunnel, and Tailscale VPN for remote access.
            Every deployment is scripted, version-controlled, and reproducible.
          </p>
          <p>
            I've published research in precision agriculture (RetinaNet for oil palm ripeness detection)
            and medical imaging (ResNet50 for brain tumor classification). I also automate
            infrastructure pipelines with PowerShell and Bash — backups, deployments, and alerting.
          </p>
        </div>
        <div>
          {education.map(e => (
            <div class="about-stat">
              <div class="about-stat-value">{e.gpa}</div>
              <div class="about-stat-label">{e.degree}</div>
              <div class="about-stat-sub">{e.school} · {e.location}</div>
              <div class="about-stat-period">{e.period}</div>
            </div>
          ))}
        </div>
      </div>
      <!-- ── Publications ── -->
      <div class="publications-section">
        <h3 class="publications-title">Publications</h3>
        <div class="publications-list">
          <div class="publication-item">
            <a href="https://garuda.kemdiktisaintek.go.id/documents/detail/5253843" target="_blank" rel="noopener noreferrer" class="publication-link">
              <span class="publication-icon">📄</span>
              <span class="publication-text">CFO-RetinaNet: Oil Palm Bunch Ripeness Detection from Aerial Imagery</span>
              <span class="publication-venue">Garuda/Kemdiktisaintek</span>
            </a>
          </div>
          <div class="publication-item">
            <a href="https://ijicom.respati.ac.id/index.php/ijicom/article/view/80" target="_blank" rel="noopener noreferrer" class="publication-link">
              <span class="publication-icon">📄</span>
              <span class="publication-text">Brain Tumor Classification Using Fine-Tuned ResNet50 and EfficientNet</span>
              <span class="publication-venue">IJICOM</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Experience ── -->
  <section id="experience" aria-labelledby="exp-title">
    <div class="section">
      <div class="section-header">
        <h2 class="section-label">
          <span class="section-label-num">Experience</span>
        </h2>
      </div>
      {experience.map(job => (
        <article class="exp-entry">
          <div class="exp-header">
            <div>
              <div class="exp-meta">
                <span class="exp-org">{job.org}</span>
                <span class="exp-period">{job.period}</span>
              </div>
              <h3 class="exp-title">{job.role}</h3>
            </div>
          </div>
          <p class="exp-desc">{job.description}</p>
          {job.stats && (
            <div class="exp-stats">
              {job.stats.map(s => <span class="exp-stat-pill">{s}</span>)}
            </div>
          )}
          <ul class="exp-achievements">
            {job.achievements.map(a => <li>{a}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <!-- ── Projects ── -->
  <section id="projects" aria-labelledby="proj-title">
    <div class="section">
      <div class="section-header">
        <h2 class="section-label">
          <span class="section-label-num">Projects</span>
        </h2>
      </div>
      <div class="filter-bar" role="group" aria-label="Filter projects">
        <button class="filter-btn active" data-filter="all" aria-pressed="true">All</button>
        <button class="filter-btn" data-filter="major" aria-pressed="false">Flagship</button>
        <button class="filter-btn" data-filter="simple" aria-pressed="false">Simple</button>
      </div>
      <div id="project-list">
      {projects.map((p, i) => (
        <ProjectCard project={p} index={i} />
      ))}
      </div>
    </div>
  </section>

  <!-- ── Skills ── -->
  <section id="skills" aria-labelledby="skills-title">
    <div class="section">
      <div class="section-header">
        <h2 class="section-label">
          <span class="section-label-num">Skills</span>
        </h2>
      </div>
      <div>
        {Object.entries(skills).map(([group, items]) => (
          <div class="skills-group">
            <div class="skills-group-label">{group}</div>
            <div class="skills-tags">
              {items.map(item => <span class={`tag ${item.core ? 'tag-core' : ''}`}>{item.name}{item.core ? <span class="core-suffix"> core</span> : ''}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Certifications ── -->
  <section id="certifications" aria-labelledby="cert-title">
    <div class="section">
      <div class="section-header">
        <h2 class="section-label">
          <span class="section-label-num">Certifications</span>
        </h2>
      </div>
      <div class="cert-grid">
        {certifications.map(c => (
          <div class="cert-item">
            <div class="cert-name">
              <span class={`cert-type-dot cert-type-${c.issuer_type}`}></span>
              {c.name}
            </div>
            <div class="cert-meta">
              <span class="cert-issuer">{c.issuer}</span>
              <span class="cert-year">{c.year}</span>
            </div>
            {c.url && (
              <a href={c.url} class="cert-link" target="_blank" rel="noopener noreferrer">
                View credential for {c.name} ↗
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Contact ── -->
  <section id="contact" aria-labelledby="contact-title">
    <div class="section">
      <div class="section-header">
        <h2 class="section-label">
          <span class="section-label-num">Contact</span>
        </h2>
      </div>
      <div class="contact-grid">
        <div class="contact-text">
          <p>
            Open to infrastructure, DevOps, and automation roles.
          </p>
          <div class="contact-response-time">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            I typically respond within 48 hours.
          </div>
          <div class="contact-links">
            <a href="#" class="contact-link" id="email-link">
              <span class="contact-link-icon">✉</span><span class="contact-link-wrap"> alkamfrz@gmail.com<button class="copy-email-btn" id="copy-email-btn" aria-label="Copy email" title="Copy email">⎘</button></span>
            </a>
            <a href="https://linkedin.com/in/alkamfrz" target="_blank" rel="noopener noreferrer" class="contact-link">
              <span class="contact-link-icon">in</span> linkedin.com/in/alkamfrz
            </a>
            <a href="https://github.com/alkamfrz" target="_blank" rel="noopener noreferrer" class="contact-link">
              <span class="contact-link-icon">⌥</span> github.com/alkamfrz
            </a>
          </div>
        </div>

        <form id="contact-form" action="https://formspree.io/f/meoegore" method="POST" novalidate aria-label="Contact form">
          <!-- honeypot: invisible to humans -->
          <div class="sr-honeypot" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <div class="form-group">
            <label for="contact-name" class="form-label">Name</label>
            <input type="text" id="contact-name" name="name" class="form-input" placeholder="Your name" required autocomplete="name" />
            <span class="form-error" id="name-error" aria-live="polite"></span>
          </div>
          <div class="form-group">
            <label for="contact-email" class="form-label">Email</label>
            <input type="email" id="contact-email" name="email" class="form-input" placeholder="you@example.com" required autocomplete="email" />
            <span class="form-error" id="email-error" aria-live="polite"></span>
          </div>
          <div class="form-group">
            <label for="contact-message" class="form-label">Message</label>
            <textarea id="contact-message" name="message" class="form-textarea" placeholder="Your message..." required></textarea>
            <span class="form-error" id="message-error" aria-live="polite"></span>
          </div>
          <div id="contact-status" class="form-status" role="status" aria-live="polite" style="display:none;"></div>
          <button type="submit" id="contact-submit" class="btn btn-primary">Send message</button>
        </form>
      </div>
    </div>
  </section>

</Layout>

<script>
  import '../scripts/home.js';
</script>
