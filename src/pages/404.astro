---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Page Not Found">
  <section class="error-section">
    <div class="term-card error-card">
      <div class="error-code">404</div>
      <p class="error-message">ERROR: page not found</p>
      <p class="error-sub">The requested resource does not exist on this server.<br/>It may have been moved, deleted, or the URL may be incorrect.</p>
      <a href="/" id="go-home-link" class="btn btn-primary btn-sm" style="display: inline-flex;">$ cd ~ &amp;&amp; ls</a>
    </div>
  </section>
</Layout>
