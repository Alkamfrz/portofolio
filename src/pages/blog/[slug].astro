---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const words = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : 0;
const readingTime = Math.max(1, Math.ceil(words / 200));

function formatDate(dateStr) {
  try { return new Date(dateStr).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }); }
  catch { return dateStr; }
}

const otherPosts = allPosts
  .filter(p => p.id !== post.id)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 2);

const blogJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "datePublished": post.data.date,
  "author": { "@type": "Person", "name": "Alkam Fariz" },
  "description": post.data.description,
  "url": `https://alkamfrz.id/blog/${post.id}`
};
---

<Layout title={post.data.title} description={post.data.description}>
  <script type="application/ld+json">{JSON.stringify(blogJsonLd)}</script>

  <article class="section" aria-labelledby="post-title-heading">
    <div class="container" style="max-width: 800px;">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">home</a>
        <span class="sep">/</span>
        <a href="/blog/">blog</a>
        <span class="sep">/</span>
        <span class="current">{post.data.title}</span>
      </nav>

      <div class="term-card blog-post-card">
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.75rem; flex-wrap: wrap;">
          <h1 id="post-title-heading" class="post-title" style="font-size: clamp(1.25rem, 3vw, 1.75rem); margin: 0;">{post.data.title}</h1>
          <!-- Font size widget -->
          <div style="display: flex; gap: 2px; font-family: var(--font-mono); font-size: var(--text-xs);">
            <button class="btn btn-sm" id="fs-sm" style="padding: 0.2rem 0.4rem;">A-</button>
            <button class="btn btn-sm active" id="fs-md" style="padding: 0.2rem 0.4rem; background: var(--accent-green); color: var(--bg-primary); border-color: var(--accent-green);">A</button>
            <button class="btn btn-sm" id="fs-lg" style="padding: 0.2rem 0.4rem;">A+</button>
          </div>
        </div>

        <div class="post-meta" style="font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-muted); margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-subtle); display: flex; gap: 1rem; flex-wrap: wrap;">
          <span>published: {formatDate(post.data.date)}</span>
          <span>⏱ {readingTime} min read</span>
          <span style="opacity: 0.5;">{words} words</span>
        </div>

        <div class="post-content text-md" id="post-content-body">
          <Content />
        </div>

        <!-- Social sharing -->
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--border-subtle); font-family: var(--font-mono); font-size: var(--text-xs);">
          <span style="color: var(--text-muted);">share:</span>
          <button class="btn btn-sm" id="share-twitter" style="padding: 0.25rem 0.6rem;">x</button>
          <button class="btn btn-sm" id="share-linkedin" style="padding: 0.25rem 0.6rem;">in</button>
          <button class="btn btn-sm" id="share-copy" style="padding: 0.25rem 0.6rem;">copy</button>
        </div>
      </div>

      <!-- Related Posts -->
      {otherPosts.length > 0 && (
        <div style="margin-top: 2rem;">
          <h3 style="font-family: var(--font-mono); font-size: var(--text-sm); color: var(--accent-green); margin-bottom: 1rem;">## continue reading</h3>
          <div class="blog-grid" style="grid-template-columns: 1fr;">
            {otherPosts.map(related => {
              const rWords = related.body ? related.body.trim().split(/\s+/).filter(Boolean).length : 0;
              const rTime = Math.max(1, Math.ceil(rWords / 200));
              return (
              <a href={`/blog/${related.id}`} class="term-card blog-card blog-post-card" style="text-decoration: none;">
                <h4 class="post-title">{related.data.title}</h4>
                <div class="post-meta">
                  <span>{formatDate(related.data.date)}</span>
                  <span>{rTime} min read</span>
                </div>
                <p class="post-desc">{related.data.description}</p>
                <span class="read-more">read more →</span>
              </a>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </article>

  <script>
    // Blog reading suite — font size, TOC highlight, social sharing, mac code copy
    (function() {
      function initBlogReadingSuite() {
        var content = document.getElementById('post-content-body');
        if (!content) return;

        // 1. Font size widget
        var sizes = [
          { id: 'fs-sm', size: 'text-sm' },
          { id: 'fs-md', size: 'text-md' },
          { id: 'fs-lg', size: 'text-lg' },
        ];
        var activeSize = 'text-md';
        sizes.forEach(function(s) {
          var btn = document.getElementById(s.id);
          if (!btn) return;
          btn.addEventListener('click', function() {
            sizes.forEach(function(x) {
              var b = document.getElementById(x.id);
              if (b) { b.style.background = ''; b.style.color = ''; b.style.borderColor = ''; }
            });
            content.classList.remove('text-sm', 'text-md', 'text-lg');
            content.classList.add(s.size);
            activeSize = s.size;
            btn.style.background = 'var(--accent-green)';
            btn.style.color = 'var(--bg-primary)';
            btn.style.borderColor = 'var(--accent-green)';
          });
        });

        // 2. Social sharing
        var pageUrl = encodeURIComponent(window.location.href);
        var pageTitle = encodeURIComponent(document.title.replace(/ —.*$/, ''));
        var twitterBtn = document.getElementById('share-twitter');
        var linkedinBtn = document.getElementById('share-linkedin');
        var shareCopyBtn = document.getElementById('share-copy');

        if (twitterBtn) twitterBtn.addEventListener('click', function() {
          window.open('https://twitter.com/intent/tweet?text=' + pageTitle + '&url=' + pageUrl, '_blank', 'noopener,width=600,height=400');
        });
        if (linkedinBtn) linkedinBtn.addEventListener('click', function() {
          window.open('https://linkedin.com/sharing/share-offsite/?url=' + pageUrl, '_blank', 'noopener,width=600,height=400');
        });
        if (shareCopyBtn) shareCopyBtn.addEventListener('click', async function() {
          try {
            await navigator.clipboard.writeText(window.location.href);
            shareCopyBtn.textContent = 'done';
            setTimeout(function() { shareCopyBtn.textContent = 'copy'; }, 2000);
          } catch { shareCopyBtn.textContent = 'fail'; }
        });

        // 3. Mac code blocks — copy button
        document.querySelectorAll('.mac-code-block').forEach(function(wrapper) {
          var copyBtn = wrapper.querySelector('.mac-copy-btn');
          if (!copyBtn) return;
          var newBtn = copyBtn.cloneNode(true);
          copyBtn.parentNode.replaceChild(newBtn, copyBtn);
          newBtn.addEventListener('click', function() {
            var code = wrapper.querySelector('code');
            var text = code ? (code.textContent || '') : (wrapper.textContent || '');
            navigator.clipboard.writeText(text).then(function() {
              newBtn.textContent = 'done';
              setTimeout(function() { newBtn.textContent = 'copy'; }, 2000);
            });
          });
        });
      }

      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initBlogReadingSuite);
      else initBlogReadingSuite();
      document.addEventListener('astro:page-load', initBlogReadingSuite);
    })();
  </script>
</Layout>
