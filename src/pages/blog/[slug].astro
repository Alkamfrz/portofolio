---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);
const words = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : 0;
const readingTime = Math.max(1, Math.ceil(words / 200));

const related = allPosts
  .filter(p => p.id !== post.id)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 2);

function fmtDate(d) {
  try {
    return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
  } catch { return d; }
}
---

<Layout title={post.data.title} description={post.data.description}>

  <!-- Breadcrumb -->
  <nav class="post-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span>›</span>
    <a href="/blog/">Writing</a>
    <span>›</span>
    <span style="color: var(--text-secondary);">{post.data.title}</span>
  </nav>

  <!-- Header -->
  <header class="post-header">
    <div class="post-meta">
      <time class="post-date" datetime={post.data.date}>{fmtDate(post.data.date)}</time>
      <span class="post-readtime">{readingTime} min read</span>
      <span class="post-readtime">{words.toLocaleString()} words</span>
    </div>
    <h1>{post.data.title}</h1>
  </header>

  <!-- Body -->
  <article class="post-body">
    <Content />
  </article>

  <!-- Related -->
  {related.length > 0 && (
    <section style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border-light);">
      <p class="section-label" style="margin-bottom: 1.25rem;">
        <span class="section-label-num">→</span>More reading
      </p>
      {related.map(rp => {
        const rwc = rp.body ? rp.body.trim().split(/\s+/).filter(Boolean).length : 0;
        const rrt = Math.max(1, Math.ceil(rwc / 200));
        return (
          <a href={`/blog/${rp.id}`} class="writing-item">
            <div class="writing-date">{fmtDate(rp.data.date)}</div>
            <div>
              <h2 class="writing-title">{rp.data.title}</h2>
              <div class="writing-meta">{rrt} min read</div>
              <p class="writing-excerpt">{rp.data.description}</p>
            </div>
          </a>
        );
      })}
    </section>
  )}

</Layout>
