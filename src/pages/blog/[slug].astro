---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);
const words = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : 0;
const readingTime = Math.max(1, Math.ceil(words / 200));

const related = allPosts
  .filter(p => p.id !== post.id)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 2);

function fmtDate(d) {
  try {
    return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
  } catch { return d; }
}
---

<Layout title={post.data.title} description={post.data.description}>

  <nav aria-label="Breadcrumb" style="margin-bottom: 2rem;">
    <ol style="display:flex;align-items:center;gap:0.5rem;list-style:none;font-size:var(--text-xs);color:var(--text-subtle);">
      <li><a href="/" style="color:var(--accent);text-decoration:none;">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/blog/" style="color:var(--accent);text-decoration:none;">Blog</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">{post.data.title}</li>
    </ol>
  </nav>

  <header class="post-header">
    <div class="post-meta">
      <time class="post-date" datetime={post.data.date}>{fmtDate(post.data.date)}</time>
      <span class="post-readtime">{readingTime} min read</span>
      <span class="post-readtime">{words.toLocaleString()} words</span>
    </div>
    <h1>{post.data.title}</h1>
  </header>

  <article class="post-body">
    <Content />
  </article>

  {related.length > 0 && (
    <section aria-label="More writing" style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border-light);">
      <div class="section-header" style="margin-bottom: 1.5rem;">
        <span class="section-num">→</span>
        <span class="section-title">More reading</span>
      </div>
      <div class="writing-list">
        {related.map(rp => {
          const rwc = rp.body ? rp.body.trim().split(/\s+/).filter(Boolean).length : 0;
          const rrt = Math.max(1, Math.ceil(rwc / 200));
          return (
            <a href={`/blog/${rp.id}`} class="writing-item">
              <div class="writing-date">{fmtDate(rp.data.date)}</div>
              <div>
                <h3 class="writing-title">{rp.data.title}</h3>
                <div class="writing-meta">{rrt} min read</div>
                <p class="writing-excerpt">{rp.data.description}</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

</Layout>
