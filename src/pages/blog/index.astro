---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = [...allPosts].sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

function fmtDate(d) {
  try {
    return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  } catch { return d; }
}
---

<Layout title="Writing" description="Writing on homelab infrastructure, automation, self-hosting, and computer vision.">

  <div class="list-header">
    <p class="section-label" style="margin-bottom: 0.5rem;">Writing</p>
    <h1>All Posts</h1>
    <p>{posts.length} {posts.length === 1 ? 'post' : 'posts'} published.</p>
  </div>

  {posts.length === 0 ? (
    <p>Nothing published yet.</p>
  ) : (
    <div>
      {posts.map(post => {
        const wc = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : 0;
        const rt = Math.max(1, Math.ceil(wc / 200));
        return (
          <a href={`/blog/${post.id}`} class="writing-item">
            <div class="writing-date">{fmtDate(post.data.date)}</div>
            <div>
              <h2 class="writing-title">{post.data.title}</h2>
              <div class="writing-meta">{rt} min read</div>
              <p class="writing-excerpt">{post.data.description}</p>
            </div>
          </a>
        );
      })}
    </div>
  )}

</Layout>
