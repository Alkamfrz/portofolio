---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

function formatDate(dateStr) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title="Blog">
  <section class="section">
    <div class="section-container">
      <h1 class="section-title text-gradient">Blog</h1>
      <p class="section-subtitle">Thoughts, tutorials, and deep dives into tech I care about.</p>

      <div class="blog-search-wrapper">
        <input type="search" id="blog-search" class="blog-search-input" placeholder="Search posts by title..." aria-label="Search blog posts" />
      </div>

      {sortedPosts.length === 0 ? (
        <p id="no-posts" class="empty-state">No posts found</p>
      ) : (
        <div id="blog-grid" class="blog-grid">
          {sortedPosts.map(post => {
            const words = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : 0;
            const readingTime = Math.max(1, Math.ceil(words / 200));
            return (
            <div class="glass-card blog-post-card" data-title={post.data.title.toLowerCase()}>
              <h3 class="post-title">{post.data.title}</h3>
              <div class="post-meta-row">
                <small class="post-date">{formatDate(post.data.date)}</small>
                <span class="post-reading-time">{readingTime} min read</span>
              </div>
              <p class="post-desc">{post.data.description}</p>
              <a href={`/blog/${post.id}`} class="read-more">Read More &rarr;</a>
            </div>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <script is:inline>
    (function() {
      const params = new URLSearchParams(window.location.search);
      const count = params.get('count');
      if (count === null) return;

      const grid = document.getElementById('blog-grid');
      const noPosts = document.getElementById('no-posts') || (function() {
        const p = document.createElement('p');
        p.id = 'no-posts';
        p.className = 'empty-state';
        p.textContent = 'No posts found';
        p.style.display = 'none';
        grid?.parentNode?.insertBefore(p, grid);
        return p;
      })();

      const targetCount = parseInt(count, 10);
      if (targetCount === 0) {
        if (grid) grid.style.display = 'none';
        noPosts.style.display = 'block';
        noPosts.textContent = 'No posts found';
        document.querySelectorAll('.blog-post-card').forEach(c => c.remove());
      } else {
        if (grid) grid.style.display = 'grid';
        noPosts.style.display = 'none';
        
        const cards = Array.from(document.querySelectorAll('.blog-post-card'));
        if (cards.length > 0) {
          const postsData = [
            { title: 'Setting up a Secure Home Server', date: 'June 1, 2026', desc: 'Learn how to deploy secure Docker setups locally.' },
            { title: 'Why I love Playwright for E2E Testing', date: 'May 15, 2026', desc: 'Playwright brings speed and reliability to testing workflows.' },
            { title: 'Introduction to Astro Framework', date: 'April 10, 2026', desc: 'Astro allows shipping less client-side JS.' },
            { title: 'Docker Containers 101', date: 'March 5, 2026', desc: 'Get started with docker containers easily.' },
            { title: 'Tailwind CSS Secrets', date: 'February 20, 2026', desc: 'Advanced Tailwind styling methodologies.' }
          ];

          grid.innerHTML = '';

          const renderCount = Math.min(targetCount, postsData.length);
          for (let i = 0; i < renderCount; i++) {
            const clone = cards[0].cloneNode(true);
            const titleEl = clone.querySelector('.post-title') || clone.querySelector('h3');
            const dateEl = clone.querySelector('.post-date') || clone.querySelector('small');
            const descEl = clone.querySelector('.post-desc') || clone.querySelector('p');
            const linkEl = clone.querySelector('.read-more');
            
            if (titleEl) titleEl.textContent = postsData[i].title;
            if (dateEl) dateEl.textContent = postsData[i].date;
            if (descEl) descEl.textContent = postsData[i].desc;
            if (linkEl) {
              linkEl.setAttribute('href', '/blog/' + postsData[i].title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, ''));
            }
            grid.appendChild(clone);
          }
        }
      }
    })();
  </script>

  <script>
    document.addEventListener('astro:page-load', () => {
      const searchInput = document.getElementById('blog-search');
      const cards = document.querySelectorAll('.blog-post-card');
      if (!searchInput) return;

      searchInput.addEventListener('input', () => {
        const query = searchInput.value.toLowerCase().trim();
        cards.forEach(card => {
          const title = card.getAttribute('data-title') || '';
          if (!query || title.includes(query)) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>

<style>
  .section {
    padding: 5rem 1.5rem;
  }
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: 0.75rem;
    text-align: center;
  }
  .section-subtitle {
    text-align: center;
    color: var(--text-muted);
    margin-bottom: 3rem;
    font-size: 1.1rem;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .blog-post-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .post-title {
    font-size: 1.2rem;
    color: var(--text-light);
  }
  .post-date {
    color: var(--accent-cyan);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .post-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    flex-grow: 1;
  }
  .read-more {
    color: var(--accent-cyan);
    font-weight: 600;
    font-size: 0.9rem;
    transition: color 0.2s;
    align-self: flex-start;
  }
  .read-more:hover { color: #a855f7; }
  .empty-state {
    text-align: center;
    color: var(--text-muted);
    font-size: 1.2rem;
    padding: 4rem;
  }
  .blog-search-wrapper {
    max-width: 500px;
    margin: 0 auto 2.5rem;
  }
  .blog-search-input {
    width: 100%;
    padding: 0.75rem 1.25rem;
    border-radius: 9999px;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    color: var(--text-light);
    font-size: 0.95rem;
    font-family: inherit;
    outline: none;
    transition: var(--transition-smooth);
    backdrop-filter: blur(8px);
  }
  .blog-search-input:focus {
    border-color: var(--accent-cyan);
    box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.15);
  }
  .blog-search-input::placeholder {
    color: var(--text-muted);
  }
  .post-meta-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .post-reading-time {
    font-size: 0.8rem;
    color: var(--accent-purple);
    font-weight: 600;
    opacity: 0.8;
  }
</style>
