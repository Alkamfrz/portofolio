---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = [...allPosts].sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

function fmtDate(d) {
  try {
    return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  } catch { return d; }
}
---

<Layout title="Blog" description="Writing on homelab infrastructure, automation, self-hosting, and computer vision.">

  <header class="blog-header">
    <p class="hero-eyebrow">Notes &amp; tutorials</p>
    <h1>Writing</h1>
    <p style="color: var(--text-muted); max-width: 36em; margin-top: 0.5rem;">
      Deep dives into homelab infrastructure, automation patterns, and self-hosting.
      {posts.length} {posts.length === 1 ? 'post' : 'posts'} published.
    </p>
  </header>

  {posts.length === 0 ? (
    <p style="color: var(--text-muted);">Nothing published yet.</p>
  ) : (
    <div class="writing-list" role="list">
      {posts.map(post => {
        const wc = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : 0;
        const rt = Math.max(1, Math.ceil(wc / 200));
        return (
          <a href={`/blog/${post.id}`} class="writing-item" role="listitem">
            <div class="writing-date">{fmtDate(post.data.date)}</div>
            <div>
              <h2 class="writing-title">{post.data.title}</h2>
              <div class="writing-meta">{rt} min read</div>
              <p class="writing-excerpt">{post.data.description}</p>
            </div>
          </a>
        );
      })}
    </div>
  )}

</Layout>
