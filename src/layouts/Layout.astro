---
import '../styles/global.css';
import ClientRouter from 'astro:components/ClientRouter.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Muhammad Alkam Alfariz — Infrastructure Engineer.' } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, 'https://alkamfrz.id').toString();

const navLinks = [
  { label: 'Experience', href: '/#experience' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Skills', href: '/#skills' },
  { label: 'Certifications', href: '/#certifications' },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} — Alkamfrz`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://alkamfrz.id/og-image.svg" />
    <meta name="theme-color" content="#0f0e0c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f2eb" media="(prefers-color-scheme: light)" />
    <meta name="keywords" content="Muhammad Alkam Alfariz, infrastructure engineer, homelab, Proxmox VE, DevOps, automation, computer vision, Jakarta" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <title>{title} — Alkamfrz</title>

    <ClientRouter />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Muhammad Alkam Alfariz",
      "givenName": "Muhammad Alkam",
      "familyName": "Alfariz",
      "jobTitle": "Activation Specialist",
      "worksFor": {
        "@type": "Organization",
        "name": "Mekari Qontak"
      },
      "alumniOf": [
        { "@type": "CollegeOrUniversity", "name": "Universitas Mercu Buana" },
        { "@type": "CollegeOrUniversity", "name": "SMKN 1 Tangerang" }
      ],
      "knowsAbout": ["Infrastructure Engineering", "Proxmox VE", "Docker", "Homelab", "Cloudflare", "Computer Vision", "Python", "DevOps", "Automation"],
      "url": "https://alkamfrz.id",
      "sameAs": [
        "https://github.com/alkamfrz",
        "https://linkedin.com/in/alkamfrz"
      ],
      "description": "Infrastructure Engineer specializing in IT automation, homelab systems, and computer vision."
    }
    </script>

    <script is:inline>
      (function() {
        var theme = localStorage.getItem('theme') || 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>

    <!-- ── Skip to content ── -->
    <a href="#main-content" class="skip-link">Skip to content</a>

    <!-- ── Top Navbar ── -->
    <header class="navbar" role="banner">
      <div class="navbar-inner">
        <a href="/" class="navbar-brand" data-astro-reload>Alkam<span class="accent">.</span></a>

        <button id="menu-btn" class="navbar-menu-btn" aria-label="Toggle menu" aria-expanded="false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>

        <nav class="navbar-links" aria-label="Main navigation">
          {navLinks.map(link => (
            <a href={link.href} class="navbar-link" data-astro-reload>{link.label}</a>
          ))}
        </nav>

        <div class="navbar-actions">
          <button id="theme-btn" class="navbar-link-btn" aria-label="Toggle theme">
            <svg id="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            <svg id="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- ── Mobile Nav Overlay ── -->
    <div id="mobile-overlay" class="mobile-overlay" aria-hidden="true">
      <nav class="mobile-nav" aria-label="Mobile navigation">
        {navLinks.map(link => (
          <a href={link.href} class="mobile-nav-link" tabindex="-1" data-astro-reload>{link.label}</a>
        ))}
      </nav>
    </div>

    <!-- ── Page ── -->
    <div class="page-wrapper">
      <main class="main-content" id="main-content">
        <slot />
      </main>

      <footer class="footer">
        <span>© <span id="footer-year"></span> Alkamfrz</span>
        <span class="footer-divider">·</span>
        <span>Built with Astro</span>
      </footer>
    </div>

    <!-- ── Back to top ── -->
    <button id="back-to-top" class="back-to-top" aria-label="Back to top">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="18 15 12 9 6 15"/></svg>
    </button>

    <script>
      import '../scripts/layout.js';
    </script>
  </body>
</html>
