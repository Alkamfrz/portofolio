---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Muhammad Alkam Alfariz — Infrastructure Engineer.' } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} — Alkamfrz`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0f0e0c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} — Alkamfrz</title>

    <script is:inline>
      (function() {
        var theme = localStorage.getItem('theme') || 'dark';
        document.documentElement.setAttribute('data-theme', theme);
        window.__currentTheme = theme;
      })();
    </script>
  </head>
  <body>

    <!-- ── Sidebar ── -->
    <aside class="sidebar" aria-label="Site navigation">
      <div class="sidebar-inner">
        <div class="sidebar-brand">
          <a href="/" class="sidebar-name">Alkam<span class="accent">.</span></a>
          <p class="sidebar-sub">Infrastructure Engineer<br>Tangerang, Indonesia</p>
          <button id="theme-btn" class="theme-btn" aria-label="Toggle theme">
            <svg id="icon-sun" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            <svg id="icon-moon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <span id="theme-label">Light mode</span>
          </button>
        </div>

        <nav class="sidebar-nav" aria-label="Main sections">
          <a href="#about" class="nav-item" data-section="about">
            <span class="nav-num">01</span>About
          </a>
          <a href="#experience" class="nav-item" data-section="experience">
            <span class="nav-num">02</span>Experience
          </a>
          <a href="#projects" class="nav-item" data-section="projects">
            <span class="nav-num">03</span>Projects
          </a>
          <a href="#skills" class="nav-item" data-section="skills">
            <span class="nav-num">04</span>Skills
          </a>
          <a href="#writing" class="nav-item" data-section="writing">
            <span class="nav-num">05</span>Writing
          </a>
        </nav>

        <div class="sidebar-links">
          <a href="https://github.com/alkamfrz" target="_blank" rel="noopener noreferrer" class="sidebar-link">GitHub</a>
          <a href="https://linkedin.com/in/alkamfrz" target="_blank" rel="noopener noreferrer" class="sidebar-link">LinkedIn</a>
          <a href="mailto:alkamfrz@gmail.com" class="sidebar-link">Email</a>
          <a href="/CV_Muhammad_Alkam_Alfariz.pdf" class="sidebar-link accent" download>Download CV</a>
        </div>
      </div>
    </aside>

    <!-- ── Mobile top bar ── -->
    <div class="mobile-bar" aria-label="Mobile navigation">
      <a href="/" class="mobile-name">Alkam<span class="accent">.</span></a>
      <div class="mobile-actions">
        <a href="/CV_Muhammad_Alkam_Alfariz.pdf" class="mobile-link" download>CV</a>
        <button id="mobile-theme-btn" class="mobile-theme-btn" aria-label="Toggle theme">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/></svg>
        </button>
      </div>
    </div>

    <!-- ── Scroll progress ── -->
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>

    <!-- ── Main ── -->
    <div class="main-wrapper">
      <main class="main-content" id="main-content">
        <slot />
      </main>
    </div>

    <script is:inline>
      (function() {
        // ── Theme ──
        function applyTheme(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('theme', theme);
          window.__currentTheme = theme;
          var sun = document.getElementById('icon-sun');
          var moon = document.getElementById('icon-moon');
          var label = document.getElementById('theme-label');
          if (sun && moon) {
            sun.style.display = theme === 'dark' ? 'block' : 'none';
            moon.style.display = theme === 'dark' ? 'none' : 'block';
          }
          if (label) label.textContent = theme === 'dark' ? 'Light mode' : 'Dark mode';
        }
        var theme = document.documentElement.getAttribute('data-theme') || 'dark';
        applyTheme(theme);

        var btn = document.getElementById('theme-btn');
        if (btn) btn.addEventListener('click', function() { applyTheme(theme === 'dark' ? 'light' : 'dark'); });
        var mb = document.getElementById('mobile-theme-btn');
        if (mb) mb.addEventListener('click', function() { applyTheme(theme === 'dark' ? 'light' : 'dark'); });

        // ── Active nav on scroll ──
        var sections = document.querySelectorAll('section[id]');
        var navItems = document.querySelectorAll('.nav-item');
        function updateNav() {
          var scrollY = window.scrollY + 100;
          var found = false;
          sections.forEach(function(sec) {
            if (found) return;
            var top = sec.offsetTop;
            var height = sec.offsetHeight;
            if (scrollY >= top && scrollY < top + height) {
              navItems.forEach(function(n) {
                n.classList.remove('active');
                if (n.getAttribute('data-section') === sec.id) {
                  n.classList.add('active');
                  found = true;
                }
              });
            }
          });
        }
        window.addEventListener('scroll', updateNav, { passive: true });
        updateNav();

        // ── Scroll progress bar ──
        var bar = document.getElementById('scroll-progress');
        if (bar) {
          window.addEventListener('scroll', function() {
            var h = document.documentElement.scrollHeight - window.innerHeight;
            bar.style.width = h > 0 ? (window.scrollY / h * 100) + '%' : '0%';
          }, { passive: true });
        }
      })();
    </script>
  </body>
</html>
