---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="social-links">
      <a id="footer-github" href="https://github.com/alkamfrz" target="_blank" rel="noopener noreferrer" aria-label="Visit Alkam Fariz on GitHub">GitHub</a>
      <a id="footer-linkedin" href="https://linkedin.com/in/alkamfrz" target="_blank" rel="noopener noreferrer" aria-label="Visit Alkam Fariz on LinkedIn">LinkedIn</a>
      <a id="footer-email" href="mailto:alkamfrz@gmail.com" aria-label="Send email to Alkam Fariz">Email</a>
    </div>
    <p>&copy; {currentYear} Alkam Fariz. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    padding: 2.5rem 1rem;
    border-top: 1px solid var(--glass-border);
    background: var(--bg-dark);
    text-align: center;
    color: var(--text-muted-dark);
    font-size: 0.875rem;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .social-links {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .social-links a {
    color: var(--text-muted-dark);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .social-links a:hover {
    color: var(--accent-cyan);
  }
</style>
