---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="social-links">
      <a id="contact-github" href="https://github.com/alkamfrz" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a id="contact-linkedin" href="https://linkedin.com/in/alkamfrz" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a id="contact-email" href="mailto:alkamfrz@gmail.com">Email</a>
    </div>
    <p>&copy; {currentYear} Alkam Fariz. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    padding: 2.5rem 1rem;
    border-top: 1px solid var(--glass-border);
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(10px);
    text-align: center;
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .social-links {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .social-links a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .social-links a:hover {
    color: var(--accent-cyan);
  }
</style>
